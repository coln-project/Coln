-- elaborated
global entry named Family
in mode: Conjunctive
type: Theory
value: sig
  person : Set
  is-parent : person -> person -> Prop
end
global entry named AncestorRelation
in mode: Conjunctive
type: (F : Family) -> Theory
value: F => sig
  is-ancestor : F.person -> F.person -> Prop
  parent-is-ancestor : (x : F.person) -> (y : F.person) -> F.is-parent x y -> is-ancestor x y
  parent-of-ancestor-is-ancestor : (x : F.person) -> (y : F.person) -> (z : F.person) -> F.is-parent x y -> is-ancestor y z -> is-ancestor x z
end
global entry named AncestryFor
in mode: Inductive
type: (F : Family) -> AncestorRelation F
value: F => init (AncestorRelation F)

-- messages
