-- elaborated
global entry named Graph
in mode: Conjunctive
type: Theory
value: sig
  V : Set
  E : V -> V -> Set
end

global entry named TransExt
in mode: Conjunctive
type: (G : Graph) -> Theory
value: G => sig
  connected : G.V -> G.V -> Set
  refl : (v : G.V) -> connected v v
  snoc : (v0 : G.V) -> (v1 : G.V) -> (v2 : G.V) -> connected v0 v1 -> G.E v1 v2 -> connected v0 v2
end

realm named TransitiveClosureSetRealm

```flir
('root.V (ground ()))
('root.E (ground ((%a 'root.V) (%b 'root.V))))
('init.trans-closure.refl (cons ((%v 'root.V)) (primarykey 1)))
('init.trans-closure.snoc
 (cons
  ((%v0 'root.V)
   (%v1 'root.V)
   (%v2 'root.V)
   (%a 'init.trans-closure.connected)
   (%b 'root.E))
  (primarykey 5)))
('init.trans-closure.connected
 ((union 'init.trans-closure.refl 'init.trans-closure.snoc)
  ((%a 'root.V) (%b 'root.V))))
