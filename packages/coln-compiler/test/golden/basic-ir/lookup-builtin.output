-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  rank : X -> Int
  E : Int -> Set
  edge : (x : X) -> E (rank x)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.rank := [a : root.X, b : Int] primarykey [a]
    table root.E := [a : Int]
    table root.edge := [x : root.X, a : root.E] primarykey [x]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.rank.foreignKey a b := root.rank [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.X []
    monitored root.rank.total a := a ∈ root.X [] ⊢ root.rank [a ↦ a]
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ ⊤
    enforced root.edge.foreignKey x a b := root.edge [
      x ↦ x,
      a ↦ a
    ] ⊢ x ∈ root.X [] ∧ root.rank [a ↦ x, b ↦ b] ∧ a ∈ root.E [a ↦ b]
    monitored root.edge.total x := x ∈ root.X [] ⊢ root.edge [x ↦ x]
  end
end

-- messages
