-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : Set
  E : B -> Prop
  x : A
  next : A -> B
  edge : E (next x)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := []
    table root.E := [a : root.B] primarykey [a]
    table root.next := [b : root.B] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ ⊤
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ a ∈ root.B []
    monitored root.x := ⊤ ⊢ root.A []
    enforced root.next.foreignKey b := root.next [
      b ↦ b
    ] ⊢ root.A [] ∧ b ∈ root.B []
    monitored root.next.total := root.A [] ⊢ root.next []
    monitored root.edge a := root.next [b ↦ a] ⊢ root.E [a ↦ a]
  end
end

-- messages
