-- elaborated
global entry named EqualTriple
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  first : X
  second : X
  proof : first = second
  trailing : X
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  value : EqualTriple X
end

realm named TRealm

```flir
('root.X (table (ground) ()))
('root.value
 (table
  (ground (primarykey 0))
  ((%a.first 'root.X) (%a.second 'root.X) (%a.trailing 'root.X))))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.value.foreignKey
 (law
  enforced
  ((%a.first 'root.X) (%a.second 'root.X) (%a.trailing 'root.X))
  (('root.value %a.first %a.second %a.trailing))
  (('root.X (id %a.first))
   ('root.X (id %a.second))
   (= 'root.X %a.first %a.second)
   ('root.X (id %a.trailing)))))
('root.value.total (law monitored () () (('root.value))))
```

