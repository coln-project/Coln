-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : Prop
  E : B -> Prop
  x : A
  next : A -> B
  edge : E (next x)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [] primarykey []
    table root.E := [] primarykey []
    table root.x := [a : root.A] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ ⊤
    enforced root.E.foreignKey := root.E [] ⊢ root.B []
    enforced root.x.foreignKey a := root.x [a ↦ a] ⊢ a ∈ root.A []
    monitored root.x.total := ⊤ ⊢ root.x []
    monitored root.next a := a ∈ root.A [] ⊢ root.B []
    monitored root.edge := ⊤ ⊢ root.E []
  end
end

-- messages
