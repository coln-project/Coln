-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  V : Prop
  E : V -> Prop
end
realm named TRealm
elaborated: realm
  generators
    node
      V = rel []
      E = rel [a : TRealm.V []]
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.V := []
    table ℜ.E := [.a : ℜ.V]
  end
  rules
    enforced ℜ.V.foreignKey := ℜ.V [] ⊢ ⊤
    enforced ℜ.E.foreignKey a := ℜ.E [.a ↦ a] ⊢ a ∈ ℜ.V []
  end
end

-- messages
