-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  Pair : (x : X) -> (x : X) -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.Pair := [x : root.X, x/a : root.X]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.Pair.foreignKey x x/a := root.Pair [
      x ↦ x,
      x/a ↦ x/a
    ] ⊢ x ∈ root.X [] ∧ x/a ∈ root.X []
  end
end

-- messages
