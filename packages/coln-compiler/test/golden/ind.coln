theory Graph := sig
  v : Set
  e : v -> v -> Prop
end

theory TransitiveExt (^i G : Graph) := sig
  p : G.v -> G.v -> Prop
  incl : (v0 v1 : G.v) -> G.e v0 v1 -> p v0 v1
  snoc : (v0 v1 v2 : G.v) -> p v0 v1 -> G.e v1 v2 -> p v0 v2
end

ind def transitive-closure (G : Graph) : TransitiveExt G := init (TransitiveExt G)
