-- elaborated
global entry named Model
in mode: Conjunctive
type: Theory
value: sig
  X : Set
end
global entry named Box
in mode: Conjunctive
type: (M : Model) -> (Y : Set) -> Set
value: M => Y => sig
  modelValue : M.X
  value : Y
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  model : Model
  boxed : Box model String -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.model.X := []
    table root.boxed := [a.modelValue : root.model.X, a.value : String]
  end
  definitions
  end
  rules
    enforced root.model.X.foreignKey := root.model.X [] ⊢ ⊤
    enforced root.boxed.foreignKey a.modelValue a.value := root.boxed [
      a.modelValue ↦ a.modelValue,
      a.value ↦ a.value
    ] ⊢ a.modelValue ∈ root.model.X []
  end
end

-- messages
