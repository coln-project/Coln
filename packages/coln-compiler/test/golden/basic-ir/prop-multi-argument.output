-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  P : Prop
  Q : Prop
  R : X -> P -> Q -> Prop
end
realm named TRealm
elaborated: realm
  generators
    node
      X = rel []
      P = rel []
      Q = rel []
      R = rel [a : TRealm.X [], b : TRealm.P [], c : TRealm.Q []]
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.X := []
    table ℜ.P := [] primarykey []
    table ℜ.Q := [] primarykey []
    table ℜ.R := [.a : ℜ.X] primarykey [.a]
  end
  rules
    enforced ℜ.X.foreignKey := ℜ.X [] ⊢ ⊤
    enforced ℜ.P.foreignKey := ℜ.P [] ⊢ ⊤
    enforced ℜ.Q.foreignKey := ℜ.Q [] ⊢ ⊤
    enforced ℜ.R.foreignKey a := ℜ.R [.a ↦ a] ⊢ a ∈ ℜ.X [] ∧ ℜ.P [] ∧ ℜ.Q []
  end
end

-- messages
