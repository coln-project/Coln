-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Set
  R : (a : A) -> B a -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [a : root.A]
    table root.R := [a : root.A, b : root.B]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey a := root.B [a ↦ a] ⊢ a ∈ root.A []
    enforced root.R.foreignKey a b := root.R [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.A [] ∧ b ∈ root.B [a ↦ a]
  end
end

-- messages
