theory Cocone (^i a : Set) (^i b : Set) := sig
  apex : Set
  inl : a -> apex
  inr : b -> apex
end

ind def Either/cocone (a : Set) (b : Set) : (Cocone a b) := (
  init (Cocone a b)
)

ind def Either (a : Set) (b : Set) : Set := Either/cocone a b .apex

