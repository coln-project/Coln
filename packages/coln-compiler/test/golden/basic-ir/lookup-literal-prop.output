-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  IntFact : Int -> Prop
  StringFact : String -> Prop
  intFact : IntFact 19
  stringFact : StringFact "zombocom"
end
realm named TRealm
lowered: flatrealm
  entities
    table root.IntFact := [a : Int] primarykey [a]
    table root.StringFact := [a : String] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.IntFact.foreignKey a := root.IntFact [a ↦ a] ⊢ ⊤
    enforced root.StringFact.foreignKey a := root.StringFact [a ↦ a] ⊢ ⊤
    monitored root.intFact := ⊤ ⊢ root.IntFact [a ↦ 19]
    monitored root.stringFact := ⊤ ⊢ root.StringFact [a ↦ "zombocom"]
  end
end

-- messages
