-- elaborated
global entry named Inner
in mode: Conjunctive
type: Set
value: sig
  rank : Int
end

global entry named Outer
in mode: Conjunctive
type: Set
value: sig
  name : String
  inner : Inner
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  payload : Outer
end

realm named TRealm

```flir
('root
 (ground ((%a.payload.name string) (%a.payload.inner.rank int)) (primarykey 0)))
('root.foreignKey
 (law
  enforced
  ((%a.payload.name string) (%a.payload.inner.rank int))
  (('root %a.payload.name %a.payload.inner.rank))
  ()))
('root.total (law monitored () () (('root))))
```

