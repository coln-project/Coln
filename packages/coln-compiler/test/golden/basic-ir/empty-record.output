-- elaborated
global entry named Unit
in mode: Conjunctive
type: Set
value: sig
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  unit : Unit
end
realm named TRealm
lowered: flatrealm
  entities
    table root := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.foreignKey := root [] ⊢ ⊤
    monitored root.total := ⊤ ⊢ root []
  end
end

-- messages
