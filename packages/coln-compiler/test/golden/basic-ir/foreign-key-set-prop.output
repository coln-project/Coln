-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  V : Set
  E : V -> Prop
end
realm named TRealm
lowered: flatrealm
  entities
    table root.V := []
    table root.E := [a : root.V] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.V.foreignKey := root.V [] ⊢ ⊤
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ a ∈ root.V []
  end
end

-- messages
