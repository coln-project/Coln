-- elaborated
global entry named Pair
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  left : X
  right : X
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  first : Pair X
  second : Pair X
  same : first = second
end

realm named TRealm

```flir
('root.X (table (ground) ()))
('root.first
 (table (ground (primarykey 0)) ((%a.left 'root.X) (%a.right 'root.X))))
('root.second
 (table (ground (primarykey 0)) ((%a.left 'root.X) (%a.right 'root.X))))
('root.X.foreignKey (law enforced () (('root.X)) ()))
