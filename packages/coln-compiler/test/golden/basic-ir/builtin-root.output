-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  count : Int
  label : String
end
realm named TRealm
lowered: flatrealm
  entities
    table root := [a.count : Int, a.label : String] primarykey []
  end
  definitions
  end
  rules
    enforced root.foreignKey a.count a.label := root [
      a.count ↦ a.count,
      a.label ↦ a.label
    ] ⊢ ⊤
    monitored root.total := ⊤ ⊢ root []
  end
end

-- messages
