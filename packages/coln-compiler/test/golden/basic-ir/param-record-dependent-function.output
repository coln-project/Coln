-- elaborated
global entry named PointAt
in mode: Conjunctive
type: (X : Set) -> (x : X) -> Set
value: X => x => sig
end

global entry named Box
in mode: Conjunctive
type: (X : Set) -> (x : X) -> (E : X -> Set) -> (f : (x : X) -> E x) -> (p : PointAt (E x) (f x)) -> Set
value: X => x => E => f => p => sig
  image : E x
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  Key : Set
  key : Key
  E : Key -> Set
  f : (x : Key) -> E x
  point : PointAt (E key) (f key)
  boxed : Box Key key E f point -> Set
end

realm named TRealm

```flir
('root.Key (table (ground) ()))
('root.key (table (ground (primarykey 0)) ((%a 'root.Key))))
('root.E (table (ground) ((%a 'root.Key))))
('root.f (table (ground (primarykey 1)) ((%x 'root.Key) (%a 'root.E))))
('root.boxed (table (ground) ((%a.image 'root.E))))
('root.Key.foreignKey (law enforced () (('root.Key)) ()))
('root.key.foreignKey
 (law enforced ((%a 'root.Key)) (('root.key %a)) (('root.Key (id %a)))))
('root.key.total (law monitored () () (('root.key))))
('root.E.foreignKey
 (law enforced ((%a 'root.Key)) (('root.E %a)) (('root.Key (id %a)))))
('root.f.foreignKey
 (law
  enforced
  ((%x 'root.Key) (%a 'root.E))
  (('root.f %x %a))
  (('root.Key (id %x)) ('root.E (id %a) %x))))
('root.f.total
 (law monitored ((%x 'root.Key)) (('root.Key (id %x))) (('root.f %x))))
('root.boxed.foreignKey
 (law
  enforced
  ((%a.image 'root.E) (%b 'root.Key))
  (('root.key %b) ('root.boxed %a.image))
  (('root.E (id %a.image) %b))))
