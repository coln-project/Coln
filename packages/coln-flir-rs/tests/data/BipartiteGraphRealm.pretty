flatrealm
  entities
    table root.red := []
    table root.blue := []
    table root.red-blue := [a : root.red, b : root.blue]
    table root.blue-red := [a : root.blue, b : root.red]
    view init.connection-info.red-red := [
      a : root.red,
      b : root.red
    ] primarykey [a, b]
    view init.connection-info.blue-blue := [
      a : root.blue,
      b : root.blue
    ] primarykey [a, b]
  end
  definitions
    chased init.connection-info.red/refl v := v ∈ root.red [] ⊢ init.connection-info.red-red [
      a ↦ v,
      b ↦ v
    ]
    chased init.connection-info.blue/refl v := v ∈ root.blue [] ⊢ init.connection-info.blue-blue [
      a ↦ v,
      b ↦ v
    ]
    chased init.connection-info.red/trans v0 v1 w0 w1 a c := v0 ∈ root.red [] ∧ v1 ∈ root.red [] ∧ w0 ∈ root.blue [] ∧ w1 ∈ root.blue [] ∧ a ∈ root.red-blue [
      a ↦ v0,
      b ↦ w0
    ] ∧ init.connection-info.blue-blue [a ↦ w0, b ↦ w1] ∧ c ∈ root.blue-red [
      a ↦ w1,
      b ↦ v1
    ] ⊢ init.connection-info.red-red [a ↦ v0, b ↦ v1]
    chased init.connection-info.blue/trans v0 v1 w0 w1 a c := v0 ∈ root.blue [] ∧ v1 ∈ root.blue [] ∧ w0 ∈ root.red [] ∧ w1 ∈ root.red [] ∧ a ∈ root.blue-red [
      a ↦ v0,
      b ↦ w0
    ] ∧ init.connection-info.red-red [a ↦ w0, b ↦ w1] ∧ c ∈ root.red-blue [
      a ↦ w1,
      b ↦ v1
    ] ⊢ init.connection-info.blue-blue [a ↦ v0, b ↦ v1]
  end
  rules
    enforced root.red.foreignKey := root.red [] ⊢ ⊤
    enforced root.blue.foreignKey := root.blue [] ⊢ ⊤
    enforced root.red-blue.foreignKey a b := root.red-blue [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.red [] ∧ b ∈ root.blue []
    enforced root.blue-red.foreignKey a b := root.blue-red [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.blue [] ∧ b ∈ root.red []
  end
end