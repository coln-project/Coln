-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  P : Prop
  x : P
  y : P
  eq : x = y
end
realm named TRealm
elaborated: realm
  generators
    node
      P = rel []
      x = (fun [] -> TRealm.P [])
      y = (fun [] -> TRealm.P [])
      eq = (fun [] -> TRealm.x [] = TRealm.y [])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.P := [] primarykey []
    table ℜ.x := [] primarykey []
    table ℜ.y := [] primarykey []
    table ℜ.eq := [] primarykey []
  end
  rules
    enforced ℜ.P.foreignKey := ℜ.P [] ⊢ ⊤
    enforced ℜ.x.foreignKey := ℜ.x [] ⊢ ℜ.P []
    monitored ℜ.x.total := ⊤ ⊢ ℜ.x []
    enforced ℜ.y.foreignKey := ℜ.y [] ⊢ ℜ.P []
    monitored ℜ.y.total := ⊤ ⊢ ℜ.y []
    enforced ℜ.eq.foreignKey := ℜ.eq [] ∧ ℜ.x [] ∧ ℜ.y [] ⊢ ⊤
    monitored ℜ.eq.total := ⊤ ⊢ ℜ.eq []
  end
end

-- messages
