-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Prop
  C : (a : A) -> B a -> Prop
  f : (a : A) -> (b : B a) -> C a b
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [a : root.A] primarykey [a]
    table root.C := [a : root.A] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey a := root.B [a ↦ a] ⊢ a ∈ root.A []
    enforced root.C.foreignKey a := root.C [a ↦ a] ⊢ a ∈ root.A [] ∧ root.B [
      a ↦ a
    ]
    monitored root.f a := a ∈ root.A [] ∧ root.B [a ↦ a] ⊢ root.C [a ↦ a]
  end
end

-- messages
