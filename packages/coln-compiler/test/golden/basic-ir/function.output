-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  Y : Set
  next : X -> Y
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.Y := []
    table root.next := [a : root.X, b : root.Y] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.Y.foreignKey := root.Y [] ⊢ ⊤
    enforced root.next.foreignKey a b := root.next [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.X [] ∧ b ∈ root.Y []
    monitored root.next.total a := a ∈ root.X [] ⊢ root.next [a ↦ a]
  end
end

-- messages
