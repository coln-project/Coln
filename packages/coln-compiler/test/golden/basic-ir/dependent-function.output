-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Set
  f : (a : A) -> B a
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [a : root.A]
    table root.f := [a : root.A, b : root.B] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey a := root.B [a ↦ a] ⊢ a ∈ root.A []
    enforced root.f.foreignKey a b := root.f [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.A [] ∧ b ∈ root.B [a ↦ a]
    monitored root.f.total a := a ∈ root.A [] ⊢ root.f [a ↦ a]
  end
end

-- messages
