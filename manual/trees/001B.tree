\title{The type of sets}
\import{prelude}

\p{There is a type \code{\kwi{Set}}, whose elements are collections of things.}

\p{As a database schema, this produces a table of completely abstract row-ids, with no associated data.}

\pre{%
\kw{theory} GoldenTicket := \kwi{Set}
}

\dbexample{
  \p{\strong{Table \code{root}}}

  \table{
    \row{\hcell{RowID}}
  }{
    \row{\cell{\code{a}}}
    \row{\cell{\code{b}}}
  }

  \p{\strong{Constraints:}
  \ul{
    \li{None.}
  }
  }
}

\p{ \mvrnote{smooth} In particular we have \code{\kwi{String} : \kwi{Set}} and \code{\kwi{Int} : \kwi{Set}}.}
