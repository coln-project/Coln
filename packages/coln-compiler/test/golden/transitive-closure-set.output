   (%b 'root.E)
   (%c 'init.trans-closure.connected))
  (('init.trans-closure.snoc (id %c) %v0 %v1 %v2 %a %b))
  ('init.trans-closure.connected (id %c) %v0 %v2)))
('root.V.foreignKey (law enforced () (('root.V)) ()))
('root.E.foreignKey
 (law
  enforced
  ((%a 'root.V) (%b 'root.V))
  (('root.E %a %b))
  (('root.V (id %a)) ('root.V (id %b)))))
('init.trans-closure.refl.foreignKey
 (law
  enforced
  ((%v 'root.V))
  (('init.trans-closure.refl %v))
  (('root.V (id %v)))))
('init.trans-closure.snoc.foreignKey
 (law
  enforced
  ((%v0 'root.V)
   (%v1 'root.V)
   (%v2 'root.V)
