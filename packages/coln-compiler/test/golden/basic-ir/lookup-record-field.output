-- elaborated
global entry named Payload
in mode: Conjunctive
type: Set
value: sig
  name : String
  rank : Int
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  payload : X -> Payload
  E : Int -> Set
  edge : (x : X) -> E (payload x .rank)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.payload := [
      a : root.X,
      b.name : String,
      b.rank : Int
    ] primarykey [a]
    table root.E := [a : Int]
    table root.edge := [x : root.X, a : root.E] primarykey [x]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.payload.foreignKey a b.name b.rank := root.payload [
      a ↦ a,
      b.name ↦ b.name,
      b.rank ↦ b.rank
    ] ⊢ a ∈ root.X []
    monitored root.payload.total a := a ∈ root.X [] ⊢ root.payload [a ↦ a]
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ ⊤
    enforced root.edge.foreignKey x a b.name b.rank := root.edge [
      x ↦ x,
      a ↦ a
    ] ⊢ x ∈ root.X [] ∧ root.payload [
      a ↦ x,
      b.name ↦ b.name,
      b.rank ↦ b.rank
    ] ∧ a ∈ root.E [a ↦ b.rank]
    monitored root.edge.total x := x ∈ root.X [] ⊢ root.edge [x ↦ x]
  end
end

-- messages
