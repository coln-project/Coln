-- elaborated
global entry named Evidence
in mode: Conjunctive
type: (X : Set) -> (actual : X) -> (expected : X) -> Set
value: X => actual => expected => sig
  proof : actual = expected
end

global entry named Result
in mode: Conjunctive
type: (X : Set) -> (expected : X) -> Set
value: X => expected => sig
  actual : X
  evidence : Evidence X actual expected
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  result : (expected : X) -> Result X expected
end

realm named TRealm

```flir
('root.X (table (ground) ()))
('root.result
 (table (ground (primarykey 1)) ((%expected 'root.X) (%a.actual 'root.X))))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.result.foreignKey
 (law
  enforced
  ((%expected 'root.X) (%a.actual 'root.X))
  (('root.result %expected %a.actual))
  (('root.X (id %expected))
   ('root.X (id %a.actual))
   (= 'root.X %a.actual %expected))))
('root.result.total
 (law
  monitored
  ((%expected 'root.X))
  (('root.X (id %expected)))
  (('root.result %expected))))
