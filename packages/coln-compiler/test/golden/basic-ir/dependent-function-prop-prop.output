-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Prop
  f : (a : A) -> B a
end
realm named TRealm
elaborated: realm
  generators
    node
      A = rel []
      B = rel [a : TRealm.A []]
      f = (fun [a : TRealm.A []] -> TRealm.B [a := a])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.A := [] primarykey []
    table ℜ.B := [] primarykey []
  end
  rules
    enforced ℜ.A.foreignKey := ℜ.A [] ⊢ ⊤
    enforced ℜ.B.foreignKey := ℜ.B [] ⊢ ℜ.A []
    monitored ℜ.f := ℜ.A [] ⊢ ℜ.B []
  end
end

-- messages
