global entry named Cell
in mode: Conjunctive
type: (X : Set) -> (Y : Set) -> (R : X -> Y -> Set) -> (x : X) -> (y : Y) -> Set
value: X => Y => R => x => y => sig
  entry : R x y
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  Y : Set
  R : X -> Y -> Set
  cells : (x : X) -> (y : Y) -> Cell X Y R x y -> Set
end

realm named TRealm

```flir
('root.X (ground ()))
('root.Y (ground ()))
('root.R (ground ((%a 'root.X) (%b 'root.Y))))
('root.cells (ground ((%x 'root.X) (%y 'root.Y) (%a.entry 'root.R))))
