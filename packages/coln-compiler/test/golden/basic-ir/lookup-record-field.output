-- elaborated
global entry named Payload
in mode: Conjunctive
type: Set
value: sig
  name : String
  rank : Int
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  payload : X -> Payload
  E : Int -> Set
  edge : (x : X) -> E (payload x .rank)
end

realm named TRealm

```flir
('root.X (ground ()))
('root.payload
 (ground ((%a 'root.X) (%b.name string) (%b.rank int)) (primarykey 1)))
('root.E (ground ((%a int))))
('root.edge (ground ((%x 'root.X) (%a 'root.E)) (primarykey 1)))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.payload.foreignKey
 (law
  enforced
  ((%a 'root.X) (%b.name string) (%b.rank int))
  (('root.payload %a %b.name %b.rank))
  (('root.X (id %a)))))
('root.payload.total
 (law monitored ((%a 'root.X)) (('root.X (id %a))) (('root.payload %a))))
('root.E.foreignKey (law enforced ((%a int)) (('root.E %a)) ()))
('root.edge.foreignKey
 (law
  enforced
  ((%x 'root.X) (%a 'root.E) (%b.name string) (%b.rank int))
  (('root.payload %x %b.name %b.rank) ('root.edge %x %a))
  (('root.X (id %x)) ('root.E (id %a) %b.rank))))
('root.edge.total
 (law monitored ((%x 'root.X)) (('root.X (id %x))) (('root.edge %x))))
```

