cabal-version: 3.4
name: coln-store-hs
version: 0.1.0.0
license: (Apache-2.0 OR MIT)
maintainer: root@owenlynch.org
author: Coln contributors
description: Haskell bindings to the Rust coln-store library
category: Language
build-type: Simple
-- `include/coln_store.h` is generated by the `coln-store-ffi` build script,
-- and it's a platform-specific build product, deliberately not checked in to version control
-- so it's strange to put here, but it's listed so that recompilation is triggered when it changes (`addDependentFile`)
-- also, maybe we can get the info directly: https://github.com/well-typed/hs-bindgen/issues/419
-- TODO look in to using custom setups, or the newer "Cabal Hooks"
-- this could also help us avoid some awkward custom (and repeated) logic in Nix and Justfiles
-- and give us something more sharable across projects
-- but neither work particularly well yet with multi-component Cabal, which is crucial for HLS robustness:
-- https://github.com/haskell/cabal/issues/10602#issuecomment-3972725796
extra-source-files:
  binding-spec.yaml
  include/coln_store.h

library
  exposed-modules:
    Coln.Store.Raw
    Coln.Store.Wrapped

  hs-source-dirs: src
  default-language: GHC2024
  default-extensions:
    BlockArguments
    OverloadedRecordDot
    OverloadedStrings

  include-dirs: include
  extra-bundled-libraries: Ccoln_store_ffi
  ghc-options: -Wall
  build-depends:
    base,
    bytestring,
    directory,
    extra,
    hs-bindgen,
    hs-bindgen-runtime,
    template-haskell,
    text,
