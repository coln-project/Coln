-- elaborated
global entry named Box
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  value : X
end

global entry named Nested
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  inner : Box X
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  nested : Nested X -> Set
end

realm named TRealm

```flir
('root.X (table (ground) ()))
('root.nested (table (ground) ((%a.inner.value 'root.X))))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.nested.foreignKey
 (law
  enforced
  ((%a.inner.value 'root.X))
  (('root.nested %a.inner.value))
  (('root.X (id %a.inner.value)))))
```

