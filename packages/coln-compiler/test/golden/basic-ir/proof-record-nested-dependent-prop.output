-- elaborated
global entry named Evidence
in mode: Conjunctive
type: (P : Prop) -> Set
value: P => sig
  proof : P
end
global entry named Package
in mode: Conjunctive
type: (P : Int -> Prop) -> Set
value: P => sig
  value : Int
  evidence : Evidence (P value)
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  P : Int -> Prop
  package : Package P
end
realm named TRealm
lowered: flatrealm
  entities
    table root.P := [a : Int] primarykey [a]
    table root.package := [a.value : Int] primarykey []
  end
  definitions
  end
  rules
    enforced root.P.foreignKey a := root.P [a ↦ a] ⊢ ⊤
    enforced root.package.foreignKey a.value := root.package [
      a.value ↦ a.value
    ] ⊢ root.P [a ↦ a.value]
    monitored root.package.total := ⊤ ⊢ root.package []
  end
end

-- messages
