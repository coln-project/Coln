-- elaborated
global entry named Slice
in mode: Conjunctive
type: (Y : Set) -> (S : Y -> Set) -> (y : Y) -> Set
value: Y => S => y => sig
  entry : S y
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  Y : Set
  R : X -> Y -> Set
  slices : (x : X) -> (y : Y) -> Slice Y (R x) y -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.Y := []
    table root.R := [a : root.X, b : root.Y]
    table root.slices := [x : root.X, y : root.Y, a.entry : root.R]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.Y.foreignKey := root.Y [] ⊢ ⊤
    enforced root.R.foreignKey a b := root.R [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.X [] ∧ b ∈ root.Y []
    enforced root.slices.foreignKey x y a.entry := root.slices [
      x ↦ x,
      y ↦ y,
      a.entry ↦ a.entry
    ] ⊢ x ∈ root.X [] ∧ y ∈ root.Y [] ∧ a.entry ∈ root.R [a ↦ x, b ↦ y]
  end
end

-- messages
