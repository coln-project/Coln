-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  V : Set
  x : V
  y : V
  eq : x = y
end
realm named TRealm
lowered: flatrealm
  entities
    table root.V := []
    table root.x := [a : root.V] primarykey []
    table root.y := [a : root.V] primarykey []
  end
  definitions
  end
  rules
    enforced root.V.foreignKey := root.V [] ⊢ ⊤
    enforced root.x.foreignKey a := root.x [a ↦ a] ⊢ a ∈ root.V []
    monitored root.x.total := ⊤ ⊢ root.x []
    enforced root.y.foreignKey a := root.y [a ↦ a] ⊢ a ∈ root.V []
    monitored root.y.total := ⊤ ⊢ root.y []
    monitored root.eq a b := root.x [a ↦ a] ∧ root.y [a ↦ b] ⊢ a = b
  end
end

-- messages
