-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Prop
  E : (x : A) -> B x -> Set
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end

realm named TRealm

```flir
('root.A (ground () (primarykey 0)))
('root.B (ground () (primarykey 0)))
('root.E (ground ()))
('root.nextedge (ground ((%a 'root.E)) (primarykey 0)))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey (law enforced () (('root.B)) (('root.A))))
('root.E.foreignKey (law enforced () (('root.E)) (('root.A) ('root.B))))
('root.next (law monitored () (('root.A)) (('root.B))))
('root.nextedge.foreignKey
 (law
  enforced
  ((%a 'root.E))
  (('root.nextedge %a))
  (('root.A) ('root.E (id %a)))))
('root.nextedge.total (law monitored () (('root.A)) (('root.nextedge))))
```

