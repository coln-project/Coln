-- elaborated
global entry named Payload
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  first : X
  second : X
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  E : X -> Set
  r : (p : Payload X) -> E p.second
end

realm named TRealm

```flir
('root.X (table (ground) ()))
('root.E (table (ground) ((%a 'root.X))))
('root.r
 (table
  (ground (primarykey 2))
  ((%p.first 'root.X) (%p.second 'root.X) (%a 'root.E))))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.E.foreignKey
 (law enforced ((%a 'root.X)) (('root.E %a)) (('root.X (id %a)))))
('root.r.foreignKey
 (law
  enforced
  ((%p.first 'root.X) (%p.second 'root.X) (%a 'root.E))
  (('root.r %p.first %p.second %a))
  (('root.X (id %p.first))
   ('root.X (id %p.second))
   ('root.E (id %a) %p.second))))
('root.r.total
 (law
  monitored
  ((%p.first 'root.X) (%p.second 'root.X))
  (('root.X (id %p.first)) ('root.X (id %p.second)))
  (('root.r %p.first %p.second))))
```

