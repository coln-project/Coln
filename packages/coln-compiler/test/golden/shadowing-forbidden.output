-- elaborated
global entry named Pair
in mode: Conjunctive
type: Set
value: sig
  x : Int
  y : Int
end
realm named ShadowRealm
elaborated: realm
  generators
    fun [] -> Pair
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ := [.a.x : Int, .a.y : Int] primarykey []
  end
  rules
    enforced ℜ.foreignKey a.x a.y := ℜ [.a.x ↦ a.x, .a.y ↦ a.y] ⊢ ⊤
    monitored ℜ.total := ⊤ ⊢ ℜ []
  end
end

