-- elaborated
global entry named Ops
in mode: Conjunctive
type: Theory
value: sig
  Addr : Set
  Ref : Set
  Field : Set
  assign : (x : Ref) -> (y : Ref) -> Set
  assign-to-field : (x : Ref) -> (f : Field) -> (y : Ref) -> Set
  assign-from-field : (x : Ref) -> (y : Ref) -> (f : Field) -> Set
end

global entry named Analysis
in mode: Conjunctive
type: (O : Ops) -> Theory
value: O => sig
  points-to : O.Ref -> O.Addr -> Prop
  points-to-field : O.Ref -> O.Field -> O.Addr -> Prop
  points-to/assign : (x : O.Ref) -> (y : O.Ref) -> (a : O.Addr) -> O.assign x y -> points-to y a -> points-to x a
  points-to-field/assign : (x : O.Ref) -> (f : O.Field) -> (y : O.Ref) -> (a : O.Addr) -> O.assign-to-field x f y -> points-to y a -> points-to-field x f a
  points-to/field-assign : (x : O.Ref) -> (y : O.Ref) -> (f : O.Field) -> (a : O.Addr) -> O.assign-from-field x y f -> points-to-field y f a -> points-to x a
end

realm named AnalysisRealm

```flir
('root.Addr (ground ()))
('root.Ref (ground ()))
('root.Field (ground ()))
('root.assign (ground ((%x 'root.Ref) (%y 'root.Ref))))
('root.assign-to-field
 (ground ((%x 'root.Ref) (%f 'root.Field) (%y 'root.Ref))))
('root.assign-from-field
 (ground ((%x 'root.Ref) (%y 'root.Ref) (%f 'root.Field))))
('init.analysis.points-to
 (view ((%a 'root.Ref) (%b 'root.Addr)) (primarykey 2)))
('init.analysis.points-to-field
 (view ((%a 'root.Ref) (%b 'root.Field) (%c 'root.Addr)) (primarykey 3)))
('init.analysis.points-to/assign
 (rule
  ((%x 'root.Ref) (%y 'root.Ref) (%a 'root.Addr) (%b 'root.assign))
  (('root.Ref (id %x))
   ('root.Ref (id %y))
   ('root.Addr (id %a))
   ('root.assign (id %b) %x %y)
   ('init.analysis.points-to %y %a))
  ('init.analysis.points-to %x %a)))
('init.analysis.points-to-field/assign
 (rule
  ((%x 'root.Ref)
   (%f 'root.Field)
   (%y 'root.Ref)
   (%a 'root.Addr)
   (%b 'root.assign-to-field))
  (('root.Ref (id %x))
   ('root.Field (id %f))
   ('root.Ref (id %y))
   ('root.Addr (id %a))
   ('root.assign-to-field (id %b) %x %f %y)
   ('init.analysis.points-to %y %a))
  ('init.analysis.points-to-field %x %f %a)))
('init.analysis.points-to/field-assign
 (rule
  ((%x 'root.Ref)
   (%y 'root.Ref)
   (%f 'root.Field)
   (%a 'root.Addr)
   (%b 'root.assign-from-field))
  (('root.Ref (id %x))
   ('root.Ref (id %y))
   ('root.Field (id %f))
   ('root.Addr (id %a))
   ('root.assign-from-field (id %b) %x %y %f)
   ('init.analysis.points-to-field %y %f %a))
  ('init.analysis.points-to %x %a)))
('root.Addr.foreignKey (law enforced () (('root.Addr)) ()))
('root.Ref.foreignKey (law enforced () (('root.Ref)) ()))
('root.Field.foreignKey (law enforced () (('root.Field)) ()))
('root.assign.foreignKey
 (law
  enforced
  ((%x 'root.Ref) (%y 'root.Ref))
  (('root.assign %x %y))
  (('root.Ref (id %x)) ('root.Ref (id %y)))))
('root.assign-to-field.foreignKey
 (law
  enforced
  ((%x 'root.Ref) (%f 'root.Field) (%y 'root.Ref))
  (('root.assign-to-field %x %f %y))
  (('root.Ref (id %x)) ('root.Field (id %f)) ('root.Ref (id %y)))))
('root.assign-from-field.foreignKey
