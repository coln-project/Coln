-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  Y : Prop
  next : X -> Y
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.Y := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.Y.foreignKey := root.Y [] ⊢ ⊤
    monitored root.next a := a ∈ root.X [] ⊢ root.Y []
  end
end

-- messages
