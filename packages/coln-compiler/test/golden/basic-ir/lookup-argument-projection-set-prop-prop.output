-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Prop
  E : (x : A) -> B x -> Prop
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [a : root.A] primarykey [a]
    table root.E := [x : root.A] primarykey [x]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey a := root.B [a ↦ a] ⊢ a ∈ root.A []
    enforced root.E.foreignKey x := root.E [x ↦ x] ⊢ x ∈ root.A [] ∧ root.B [
      a ↦ x
    ]
    monitored root.next x := x ∈ root.A [] ⊢ root.B [a ↦ x]
    monitored root.nextedge x := x ∈ root.A [] ⊢ root.E [x ↦ x]
  end
end

-- messages
