  f : (a : A) -> (b : B a) -> C a b
end

realm named TRealm

```flir
('root.A (ground ()))
('root.B (ground ((%a 'root.A)) (primarykey 1)))
('root.C (ground ((%a 'root.A))))
('root.f (ground ((%a 'root.A) (%c 'root.C)) (primarykey 1)))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey
 (law enforced ((%a 'root.A)) (('root.B %a)) (('root.A (id %a)))))
('root.C.foreignKey
 (law enforced ((%a 'root.A)) (('root.C %a)) (('root.A (id %a)) ('root.B %a))))
('root.f.foreignKey
 (law
  enforced
  ((%a 'root.A) (%c 'root.C))
  (('root.f %a %c))
  (('root.A (id %a)) ('root.B %a) ('root.C (id %c) %a))))
('root.f.total
 (law monitored ((%a 'root.A)) (('root.A (id %a)) ('root.B %a)) (('root.f %a))))
