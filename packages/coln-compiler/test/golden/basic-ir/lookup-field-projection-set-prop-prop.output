-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : Prop
  E : B -> Prop
  x : A
  next : A -> B
  edge : E (next x)
end
realm named TRealm
elaborated: realm
  generators
    node
      A = rel []
      B = rel []
      E = rel [a : TRealm.B []]
      x = (fun [] -> TRealm.A [])
      next = (fun [a : TRealm.A []] -> TRealm.B [])
      edge = (fun [] -> TRealm.E [a := TRealm.next [a := TRealm.x []]])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.A := []
    table ℜ.B := [] primarykey []
    table ℜ.E := [] primarykey []
    table ℜ.x := [.a : ℜ.A] primarykey []
  end
  rules
    enforced ℜ.A.foreignKey := ℜ.A [] ⊢ ⊤
    enforced ℜ.B.foreignKey := ℜ.B [] ⊢ ⊤
    enforced ℜ.E.foreignKey := ℜ.E [] ⊢ ℜ.B []
    enforced ℜ.x.foreignKey a := ℜ.x [.a ↦ a] ⊢ a ∈ ℜ.A []
    monitored ℜ.x.total := ⊤ ⊢ ℜ.x []
    monitored ℜ.next a := a ∈ ℜ.A [] ⊢ ℜ.B []
    monitored ℜ.edge a.a.a := ℜ.x [.a ↦ a.a.a] ⊢ ℜ.E []
  end
end

-- messages
