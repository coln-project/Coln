-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Set
  f : (a : A) -> B a
end
realm named TRealm
elaborated: realm
  generators
    node
      A = rel []
      B = rel [a : TRealm.A []]
      f = (fun [a : TRealm.A []] -> TRealm.B [a := a])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.A := [] primarykey []
    table ℜ.B := []
    table ℜ.f := [.b : ℜ.B] primarykey []
  end
  rules
    enforced ℜ.A.foreignKey := ℜ.A [] ⊢ ⊤
    enforced ℜ.B.foreignKey := ℜ.B [] ⊢ ℜ.A []
    enforced ℜ.f.foreignKey b := ℜ.f [.b ↦ b] ⊢ ℜ.A [] ∧ b ∈ ℜ.B []
    monitored ℜ.f.total := ℜ.A [] ⊢ ℜ.f []
  end
end

-- messages
