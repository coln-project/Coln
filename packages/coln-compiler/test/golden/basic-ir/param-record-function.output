-- elaborated
global entry named Box
in mode: Conjunctive
type: (X : Set) -> (f : X -> X) -> (Y : Set) -> Set
value: X => f => Y => sig
  key : X
  value : Y
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  Key : Set
  f : Key -> Key
  boxed : Box Key f String -> Set
end

realm named TRealm

```flir
('root.Key (table (ground) ()))
('root.f (table (ground (primarykey 1)) ((%a 'root.Key) (%b 'root.Key))))
('root.boxed (table (ground) ((%a.key 'root.Key) (%a.value string))))
('root.Key.foreignKey (law enforced () (('root.Key)) ()))
('root.f.foreignKey
 (law
  enforced
  ((%a 'root.Key) (%b 'root.Key))
  (('root.f %a %b))
  (('root.Key (id %a)) ('root.Key (id %b)))))
('root.f.total
 (law monitored ((%a 'root.Key)) (('root.Key (id %a))) (('root.f %a))))
('root.boxed.foreignKey
 (law
  enforced
  ((%a.key 'root.Key) (%a.value string))
  (('root.boxed %a.key %a.value))
  (('root.Key (id %a.key)))))
```

