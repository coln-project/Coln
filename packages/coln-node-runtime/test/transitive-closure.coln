theory Graph := sig
  V : Set
  E : V -> V -> Set
  blah : (^c v0 : V) -> (^c v1 : V) -> E v0 v1 -> v0 = v1
end

theory TransExt (^i G : Graph) := sig
  connected : G.V -> G.V -> Prop
  refl : (v : G.V) -> connected v v
  snoc : (v0 : G.V) -> (v1 : G.V) -> (v2 : G.V) -> connected v0 v1 -> G.E v1 v2 -> connected v0 v2
end

realm TransitiveClosureRealm @ Graph
  ind def trans-closure : TransExt root := init (TransExt root)

  ind def down-set (from : root.V) : Set := sig
    into : root.V
    connected : trans-closure.connected from into
  end
end
