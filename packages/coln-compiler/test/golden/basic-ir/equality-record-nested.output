-- elaborated
global entry named Unit
in mode: Conjunctive
type: Set
value: sig
end
global entry named Inner
in mode: Conjunctive
type: (X : Set) -> (P : Prop) -> Set
value: X => P => sig
  value : X
  evidence : P
end
global entry named Outer
in mode: Conjunctive
type: (X : Set) -> (P : Prop) -> Set
value: X => P => sig
  unit : Unit
  inner : Inner X P
  trailing : X
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  P : Prop
  first : Outer X P
  second : Outer X P
  same : first = second
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.P := [] primarykey []
    table root.first := [
      a.inner.value : root.X,
      a.trailing : root.X
    ] primarykey []
    table root.second := [
      a.inner.value : root.X,
      a.trailing : root.X
    ] primarykey []
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.P.foreignKey := root.P [] ⊢ ⊤
    enforced root.first.foreignKey a.inner.value a.trailing := root.first [
      a.inner.value ↦ a.inner.value,
      a.trailing ↦ a.trailing
    ] ⊢ a.inner.value ∈ root.X [] ∧ root.P [] ∧ a.trailing ∈ root.X []
    monitored root.first.total := ⊤ ⊢ root.first []
    enforced root.second.foreignKey a.inner.value a.trailing := root.second [
      a.inner.value ↦ a.inner.value,
      a.trailing ↦ a.trailing
    ] ⊢ a.inner.value ∈ root.X [] ∧ root.P [] ∧ a.trailing ∈ root.X []
    monitored root.second.total := ⊤ ⊢ root.second []
    monitored root.same a.inner.value a.trailing b.inner.value b.trailing := root.first [
      a.inner.value ↦ a.inner.value,
      a.trailing ↦ a.trailing
    ] ∧ root.second [
      a.inner.value ↦ b.inner.value,
      a.trailing ↦ b.trailing
    ] ⊢ a.inner.value = b.inner.value ∧ a.trailing = b.trailing
  end
end

-- messages
