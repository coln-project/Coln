-- elaborated
global entry named Unit
in mode: Conjunctive
type: Set
value: sig
end

global entry named Inner
in mode: Conjunctive
type: (X : Set) -> (P : Prop) -> Set
value: X => P => sig
  value : X
  evidence : P
end

global entry named Outer
in mode: Conjunctive
type: (X : Set) -> (P : Prop) -> Set
value: X => P => sig
  unit : Unit
  inner : Inner X P
  trailing : X
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  P : Prop
  first : Outer X P
  second : Outer X P
  same : first = second
end

realm named TRealm

```flir
('root.X (ground ()))
('root.P (ground () (primarykey 0)))
('root.first
 (ground ((%a.inner.value 'root.X) (%a.trailing 'root.X)) (primarykey 0)))
('root.second
 (ground ((%a.inner.value 'root.X) (%a.trailing 'root.X)) (primarykey 0)))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.P.foreignKey (law enforced () (('root.P)) ()))
('root.first.foreignKey
 (law
  enforced
  ((%a.inner.value 'root.X) (%a.trailing 'root.X))
  (('root.first %a.inner.value %a.trailing))
  (('root.X (id %a.inner.value)) ('root.P) ('root.X (id %a.trailing)))))
('root.first.total (law monitored () () (('root.first))))
('root.second.foreignKey
 (law
  enforced
  ((%a.inner.value 'root.X) (%a.trailing 'root.X))
  (('root.second %a.inner.value %a.trailing))
  (('root.X (id %a.inner.value)) ('root.P) ('root.X (id %a.trailing)))))
('root.second.total (law monitored () () (('root.second))))
('root.same
 (law
  monitored
  ((%a.inner.value 'root.X)
   (%a.trailing 'root.X)
   (%b.inner.value 'root.X)
   (%b.trailing 'root.X))
  (('root.first %a.inner.value %a.trailing)
   ('root.second %b.inner.value %b.trailing))
  ((= 'root.X %a.inner.value %b.inner.value)
   (= 'root.X %a.trailing %b.trailing))))
