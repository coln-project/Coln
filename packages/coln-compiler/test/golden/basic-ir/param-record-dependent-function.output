-- elaborated
global entry named PointAt
in mode: Conjunctive
type: (X : Set) -> (x : X) -> Set
value: X => x => sig
end
global entry named Box
in mode: Conjunctive
type: (X : Set) -> (x : X) -> (E : X -> Set) -> (f : (x : X) -> E x) -> (p : PointAt (E x) (f x)) -> Set
value: X => x => E => f => p => sig
  image : E x
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  Key : Set
  key : Key
  E : Key -> Set
  f : (x : Key) -> E x
  point : PointAt (E key) (f key)
  boxed : Box Key key E f point -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.Key := []
    table root.key := [a : root.Key] primarykey []
    table root.E := [a : root.Key]
    table root.f := [x : root.Key, a : root.E] primarykey [x]
    table root.boxed := [a.image : root.E]
  end
  definitions
  end
  rules
    enforced root.Key.foreignKey := root.Key [] ⊢ ⊤
    enforced root.key.foreignKey a := root.key [a ↦ a] ⊢ a ∈ root.Key []
    monitored root.key.total := ⊤ ⊢ root.key []
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ a ∈ root.Key []
    enforced root.f.foreignKey x a := root.f [
      x ↦ x,
      a ↦ a
    ] ⊢ x ∈ root.Key [] ∧ a ∈ root.E [a ↦ x]
    monitored root.f.total x := x ∈ root.Key [] ⊢ root.f [x ↦ x]
    enforced root.boxed.foreignKey a.image b := root.boxed [
      a.image ↦ a.image
    ] ⊢ root.key [a ↦ b] ∧ a.image ∈ root.E [a ↦ b]
  end
end

-- messages
