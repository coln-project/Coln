{
  "name": "@coln-project/node-runtime",
  "scripts": {
    "build": "tsc; mkdir -p dist/native; napi build --platform --esm -o dist/native",
    "prepack": "npm run build"
  },
  "napi": {
    "binaryName": "coln-node-runtime"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/typescript/index.d.ts",
      "import": "./dist/src/typescript/index.js"
    }
  },
  "dependencies": {
    "@coln-project/interface": "link:../coln-js-interface"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^26.6.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
