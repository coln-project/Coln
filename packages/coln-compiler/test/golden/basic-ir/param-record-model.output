-- elaborated
global entry named Model
in mode: Conjunctive
type: Theory
value: sig
  X : Set
end

global entry named Box
in mode: Conjunctive
type: (M : Model) -> (Y : Set) -> Set
value: M => Y => sig
  modelValue : M.X
  value : Y
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  model : Model
  boxed : Box model String -> Set
end

realm named TRealm

```flir
('root.model.X (table (ground) ()))
('root.boxed (table (ground) ((%a.modelValue 'root.model.X) (%a.value string))))
('root.model.X.foreignKey (law enforced () (('root.model.X)) ()))
('root.boxed.foreignKey
 (law
  enforced
  ((%a.modelValue 'root.model.X) (%a.value string))
  (('root.boxed %a.modelValue %a.value))
  (('root.model.X (id %a.modelValue)))))
```

