-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Prop
  R : (a : A) -> B a -> Prop
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [a : root.A] primarykey [a]
    table root.R := [a : root.A] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey a := root.B [a ↦ a] ⊢ a ∈ root.A []
    enforced root.R.foreignKey a := root.R [a ↦ a] ⊢ a ∈ root.A [] ∧ root.B [
      a ↦ a
    ]
  end
end

-- messages
