-- elaborated
global entry named Graph
in mode: Conjunctive
type: Theory
value: sig
  V : Set
  E : V -> V -> Set
end
realm named GraphRealm
elaborated: realm
  generators
    node
      V = rel []
      E = rel [a : GraphRealm.V [], b : GraphRealm.V []]
    end
  end
  definitions
    def free-edge : Set := sig
      v0 : root.V
      v1 : root.V
      e : root.E v0 v1
    end
    def free-edge-pair : Set := sig
      e0 : free-edge
      e1 : free-edge
    end
  end
end
lowered: flatrealm
  entities
    table ℜ.V := []
    table ℜ.E := [.a : ℜ.V, .b : ℜ.V]
  end
  rules
    enforced ℜ.V.foreignKey := ℜ.V [] ⊢ ⊤
    enforced ℜ.E.foreignKey a b := ℜ.E [
      .a ↦ a,
      .b ↦ b
    ] ⊢ a ∈ ℜ.V [] ∧ b ∈ ℜ.V []
  end
end

-- messages
