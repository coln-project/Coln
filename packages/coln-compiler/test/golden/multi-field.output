in mode: Conjunctive
type: Theory
value: sig
  B : Set
  x : B
  y : B
  z w : B
  P : Prop
  p : P
  q : P
  r s : P
end
global entry named SimpleSets
in mode: Conjunctive
type: Theory
value: sig
  B : Set
  x : B
  y z : B
  w : B
end
global entry named simple-model
in mode: Conjunctive
type: SimpleSets
value: [B := Int, x := 41, y := 19, z := 34, w := 38]
global entry named OnlyGroup
in mode: Conjunctive
type: Set
value: sig
  a b : Int
