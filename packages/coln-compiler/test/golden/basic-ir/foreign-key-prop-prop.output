-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  V : Prop
  E : V -> Prop
end
realm named TRealm
lowered: flatrealm
  entities
    table root.V := [] primarykey []
    table root.E := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.V.foreignKey := root.V [] ⊢ ⊤
    enforced root.E.foreignKey := root.E [] ⊢ root.V []
  end
end

-- messages
