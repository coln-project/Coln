-- elaborated
global entry named Evidence
in mode: Conjunctive
type: (X : Set) -> (actual : X) -> (expected : X) -> Set
value: X => actual => expected => sig
  proof : actual = expected
end
global entry named Result
in mode: Conjunctive
type: (X : Set) -> (expected : X) -> Set
value: X => expected => sig
  actual : X
  evidence : Evidence X actual expected
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  result : (expected : X) -> Result X expected
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.result := [expected : root.X, a.actual : root.X] primarykey [
      expected
    ]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.result.foreignKey expected a.actual := root.result [
      expected ↦ expected,
      a.actual ↦ a.actual
    ] ⊢ expected ∈ root.X [] ∧ a.actual ∈ root.X [] ∧ a.actual = expected
    monitored root.result.total expected := expected ∈ root.X [] ⊢ root.result [
      expected ↦ expected
    ]
  end
end

-- messages
