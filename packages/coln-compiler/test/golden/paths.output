-- elaborated
global entry named Graph
in mode: Conjunctive
type: Theory
value: sig
  V : Set
  E : V -> V -> Prop
end

global entry named Reachability/motive
in mode: Conjunctive
type: (G : Graph) -> Theory
value: G => sig
  t : G.V -> G.V -> Prop
  empty : (x : G.V) -> t x x
  cons : (x y z : G.V) -> (e : G.E x y) -> t y z -> t x z
end

realm named PathsRealm

```flir
('root.V (table (ground) ()))
('root.E (table (ground (primarykey 2)) ((%a 'root.V) (%b 'root.V))))
('init.reachability.t (table view ((%a 'root.V) (%b 'root.V))))
('init.reachability.empty
 (rule ((%x 'root.V)) (('root.V (id %x))) ('init.reachability.t %x %x)))
('init.reachability.cons
 (rule
  ((%x 'root.V) (%y 'root.V) (%z 'root.V))
  (('root.V (id %x))
   ('root.V (id %y))
   ('root.V (id %z))
   ('root.E %x %y)
   ('init.reachability.t %y %z))
  ('init.reachability.t %x %z)))
('root.V.foreignKey (law enforced () (('root.V)) ()))
('root.E.foreignKey
 (law
  enforced
  ((%a 'root.V) (%b 'root.V))
  (('root.E %a %b))
  (('root.V (id %a)) ('root.V (id %b)))))
```

