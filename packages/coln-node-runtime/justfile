build-runtime:
    npx napi build --platform --esm -o native
    mkdir -p dist
    rm -rf dist/native
    cp -r native dist/native

build-interface:
    cd ../coln-js-interface/
    mkdir -p dist
    tsc

generate-bindings:
    mkdir -p test/bindings
    cabal run coln-cli -- generate-ts test/definitions.coln -o test/bindings/

test: 
    mkdir -p dist
    tsc
    cabal run coln-cli -- generate-ir test/definitions.coln -o dist/test
    node dist/test/main.js

build-and-test: build-interface build-runtime generate-bindings test
