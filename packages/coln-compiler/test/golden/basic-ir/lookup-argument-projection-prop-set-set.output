-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Set
  E : (x : A) -> B x -> Set
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := []
    table root.E := [a : root.B]
    table root.next := [a : root.B] primarykey []
    table root.nextedge := [a : root.E] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ root.A []
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ root.A [] ∧ a ∈ root.B []
    enforced root.next.foreignKey a := root.next [
      a ↦ a
    ] ⊢ root.A [] ∧ a ∈ root.B []
    monitored root.next.total := root.A [] ⊢ root.next []
    enforced root.nextedge.foreignKey a b := root.nextedge [
      a ↦ a
    ] ⊢ root.A [] ∧ root.next [a ↦ b] ∧ a ∈ root.E [a ↦ b]
    monitored root.nextedge.total := root.A [] ⊢ root.nextedge []
  end
end

-- messages
