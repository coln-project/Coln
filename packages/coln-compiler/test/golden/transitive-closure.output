-- elaborated
global entry named Graph
in mode: Conjunctive
type: Theory
value: sig
  V : Set
  E : V -> V -> Set
end

global entry named TransExt
in mode: Conjunctive
type: (G : Graph) -> Theory
value: G => sig
  connected : G.V -> G.V -> Prop
  refl : (v : G.V) -> connected v v
  snoc : (v0 v1 v2 : G.V) -> connected v0 v1 -> G.E v1 v2 -> connected v0 v2
end

realm named TransitiveClosureRealm

```flir
('root.V (ground ()))
('root.E (ground ((%a 'root.V) (%b 'root.V))))
('init.trans-closure.connected
 (view ((%a 'root.V) (%b 'root.V)) (primarykey 2)))
('init.trans-closure.refl
 (rule
  ((%v 'root.V))
  (('root.V (id %v)))
  ('init.trans-closure.connected %v %v)))
('init.trans-closure.snoc
 (rule
  ((%v0 'root.V) (%v1 'root.V) (%v2 'root.V) (%b 'root.E))
  (('root.V (id %v0))
   ('root.V (id %v1))
   ('root.V (id %v2))
   ('init.trans-closure.connected %v0 %v1)
   ('root.E (id %b) %v1 %v2))
  ('init.trans-closure.connected %v0 %v2)))
('root.V.foreignKey (law enforced () (('root.V)) ()))
('root.E.foreignKey
 (law
  enforced
  ((%a 'root.V) (%b 'root.V))
  (('root.E %a %b))
  (('root.V (id %a)) ('root.V (id %b)))))
```

