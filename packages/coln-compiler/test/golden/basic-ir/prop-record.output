-- elaborated
global entry named And
in mode: Conjunctive
type: (P : Prop) -> (Q : Prop) -> Prop
value: P => Q => sig
  left : P
  right : Q
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  P : Prop
  Q : Prop
  make : P -> Q -> And P Q
  projectLeft : And P Q -> P
end
realm named TRealm
lowered: flatrealm
  entities
    table root.P := [] primarykey []
    table root.Q := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.P.foreignKey := root.P [] ⊢ ⊤
    enforced root.Q.foreignKey := root.Q [] ⊢ ⊤
    monitored root.make := root.P [] ∧ root.Q [] ⊢ root.P [] ∧ root.Q []
    monitored root.projectLeft := root.P [] ∧ root.Q [] ⊢ root.P []
  end
end

-- messages
