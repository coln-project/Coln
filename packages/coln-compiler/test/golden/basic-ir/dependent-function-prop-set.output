-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Set
  f : (a : A) -> B a
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := []
    table root.f := [b : root.B] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ root.A []
    enforced root.f.foreignKey b := root.f [b ↦ b] ⊢ root.A [] ∧ b ∈ root.B []
    monitored root.f.total := root.A [] ⊢ root.f []
  end
end

-- messages
