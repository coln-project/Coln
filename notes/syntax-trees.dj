```
theory Expr/motive := sig
  t : Set
  const : Int -> t
  plus : t -> t -> t
end

ind def Expr : Expr/motive := init Expr/motive
```

```
enum t-tag {
  'const
  'plus
}

table t (a : union{const, plus}) (tag : t-tag) primary key (a)
table const (a : Int)
table plus (a : t) (b : t)
```

```
memoized view t ()
table const (a : Int) (b : t) primary key (a) chased-fd (a -> b)
table plus (a : t) (b : t) (c : t) primary key (a,b) chased-fd (a b -> c)
definition const.construct (@const) |- b \in t()
definition plus.construct (@plus) a \in t /\ b \in t |- c \in t
```

```
sum table t ()
constructor const (a : Int) for t
constructor plus (a : t) (b : t) for t
```

```
theory IndExpr/motive := sig
  t : Int -> Set
  const : (i : Int) -> Fin i -> t i
  var : (i : Int) -> String -> t i
  plus : (i j : Int) -> t i -> t j -> t (i + j)
end
```

```
sum view t (a : Int)
constructor const (i : Int) (a : Int) for t
constructor var (i : Int) (b : String) for t
constructor plus (i : Int) (j : Int) (a : t) (b : t) for t

paramdef (r : const) |- construct(r) ∈ t(r.i)
paramdef (r : var) |- construct(r) ∈ t(r.i)
paramdef (r : plus) |- construct(r) ∈ t(r.i + r.j)

enforced var.valid i j a b. plus(i, j, a, b) |- a ∈ t(i) /\ b ∈ t(j)
```
