-- elaborated
global entry named Pair
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  left : X
  right : X
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  first : Pair X
  second : Pair X
  same : first = second
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.first := [a.left : root.X, a.right : root.X] primarykey []
    table root.second := [a.left : root.X, a.right : root.X] primarykey []
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.first.foreignKey a.left a.right := root.first [
      a.left ↦ a.left,
      a.right ↦ a.right
    ] ⊢ a.left ∈ root.X [] ∧ a.right ∈ root.X []
    monitored root.first.total := ⊤ ⊢ root.first []
    enforced root.second.foreignKey a.left a.right := root.second [
      a.left ↦ a.left,
      a.right ↦ a.right
    ] ⊢ a.left ∈ root.X [] ∧ a.right ∈ root.X []
    monitored root.second.total := ⊤ ⊢ root.second []
    monitored root.same a.left a.right b.left b.right := root.first [
      a.left ↦ a.left,
      a.right ↦ a.right
    ] ∧ root.second [
      a.left ↦ b.left,
      a.right ↦ b.right
    ] ⊢ a.left = b.left ∧ a.right = b.right
  end
end

-- messages
