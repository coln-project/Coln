-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : Set
  C : Set
  E : C -> Set
  first : A -> B
  second : B -> C
  edge : (x : A) -> E (second (first x))
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := []
    table root.C := []
    table root.E := [a : root.C]
    table root.first := [a : root.A, b : root.B] primarykey [a]
    table root.second := [a : root.B, b : root.C] primarykey [a]
    table root.edge := [x : root.A, a : root.E] primarykey [x]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ ⊤
    enforced root.C.foreignKey := root.C [] ⊢ ⊤
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ a ∈ root.C []
    enforced root.first.foreignKey a b := root.first [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.A [] ∧ b ∈ root.B []
    monitored root.first.total a := a ∈ root.A [] ⊢ root.first [a ↦ a]
    enforced root.second.foreignKey a b := root.second [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.B [] ∧ b ∈ root.C []
    monitored root.second.total a := a ∈ root.B [] ⊢ root.second [a ↦ a]
    enforced root.edge.foreignKey x a b c := root.edge [
      x ↦ x,
      a ↦ a
    ] ⊢ x ∈ root.A [] ∧ root.first [a ↦ x, b ↦ c] ∧ root.second [
      a ↦ c,
      b ↦ b
    ] ∧ a ∈ root.E [a ↦ b]
    monitored root.edge.total x := x ∈ root.A [] ⊢ root.edge [x ↦ x]
  end
end

-- messages
