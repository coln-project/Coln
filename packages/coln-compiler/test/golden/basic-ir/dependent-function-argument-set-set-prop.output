-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Set
  C : (a : A) -> B a -> Prop
  f : (a : A) -> (b : B a) -> C a b
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [a : root.A]
    table root.C := [a : root.A, b : root.B] primarykey [a, b]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey a := root.B [a ↦ a] ⊢ a ∈ root.A []
    enforced root.C.foreignKey a b := root.C [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.A [] ∧ b ∈ root.B [a ↦ a]
    monitored root.f a b := a ∈ root.A [] ∧ b ∈ root.B [a ↦ a] ⊢ root.C [
      a ↦ a,
      b ↦ b
    ]
  end
end

-- messages
