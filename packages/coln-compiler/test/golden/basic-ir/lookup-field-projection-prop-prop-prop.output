-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : Prop
  E : B -> Prop
  x : A
  next : A -> B
  edge : E (next x)
end
realm named TRealm
elaborated: realm
  generators
    node
      A = rel []
      B = rel []
      E = rel [a : TRealm.B []]
      x = (fun [] -> TRealm.A [])
      next = (fun [a : TRealm.A []] -> TRealm.B [])
      edge = (fun [] -> TRealm.E [a := TRealm.next [a := TRealm.x []]])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.A := [] primarykey []
    table ℜ.B := [] primarykey []
    table ℜ.E := [] primarykey []
  end
  rules
    enforced ℜ.A.foreignKey := ℜ.A [] ⊢ ⊤
    enforced ℜ.B.foreignKey := ℜ.B [] ⊢ ⊤
    enforced ℜ.E.foreignKey := ℜ.E [] ⊢ ℜ.B []
    monitored ℜ.x := ⊤ ⊢ ℜ.A []
    monitored ℜ.next := ℜ.A [] ⊢ ℜ.B []
    monitored ℜ.edge := ⊤ ⊢ ℜ.E []
  end
end

-- messages
