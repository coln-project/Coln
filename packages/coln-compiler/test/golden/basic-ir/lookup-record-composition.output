-- elaborated
global entry named Key
in mode: Conjunctive
type: Set
value: sig
  rank : Int
end
global entry named Payload
in mode: Conjunctive
type: Set
value: sig
  name : String
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  key : X -> Key
  PayloadAt : Int -> Set
  slot : (x : X) -> PayloadAt (key x .rank)
  payload : (rank : Int) -> PayloadAt rank -> Payload
  E : String -> Set
  edge : (x : X) -> E (payload (key x .rank) (slot x) .name)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.key := [a : root.X, b.rank : Int] primarykey [a]
    table root.PayloadAt := [a : Int]
    table root.slot := [x : root.X, a : root.PayloadAt] primarykey [x]
    table root.payload := [
      rank : Int,
      a : root.PayloadAt,
      b.name : String
    ] primarykey [rank, a]
    table root.E := [a : String]
    table root.edge := [x : root.X, a : root.E] primarykey [x]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.key.foreignKey a b.rank := root.key [
      a ↦ a,
      b.rank ↦ b.rank
    ] ⊢ a ∈ root.X []
    monitored root.key.total a := a ∈ root.X [] ⊢ root.key [a ↦ a]
    enforced root.PayloadAt.foreignKey a := root.PayloadAt [a ↦ a] ⊢ ⊤
    enforced root.slot.foreignKey x a b.rank := root.slot [
      x ↦ x,
      a ↦ a
    ] ⊢ x ∈ root.X [] ∧ root.key [a ↦ x, b.rank ↦ b.rank] ∧ a ∈ root.PayloadAt [
      a ↦ b.rank
    ]
    monitored root.slot.total x := x ∈ root.X [] ⊢ root.slot [x ↦ x]
    enforced root.payload.foreignKey rank a b.name := root.payload [
      rank ↦ rank,
      a ↦ a,
      b.name ↦ b.name
    ] ⊢ a ∈ root.PayloadAt [a ↦ rank]
    monitored root.payload.total rank a := a ∈ root.PayloadAt [
      a ↦ rank
    ] ⊢ root.payload [rank ↦ rank, a ↦ a]
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ ⊤
    enforced root.edge.foreignKey x a b.name c.rank d := root.edge [
      x ↦ x,
      a ↦ a
    ] ⊢ x ∈ root.X [] ∧ root.key [a ↦ x, b.rank ↦ c.rank] ∧ root.slot [
      x ↦ x,
      a ↦ d
    ] ∧ root.payload [rank ↦ c.rank, a ↦ d, b.name ↦ b.name] ∧ a ∈ root.E [
      a ↦ b.name
    ]
    monitored root.edge.total x := x ∈ root.X [] ⊢ root.edge [x ↦ x]
  end
end

-- messages
