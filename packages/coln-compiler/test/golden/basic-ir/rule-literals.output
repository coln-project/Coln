-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  count : X -> Int
  label : X -> String
  countIs19 : (x : X) -> count x = 19
  labelIsZombocom : (x : X) -> label x = "zombocom"
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.count := [a : root.X, b : Int] primarykey [a]
    table root.label := [a : root.X, b : String] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.count.foreignKey a b := root.count [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.X []
    monitored root.count.total a := a ∈ root.X [] ⊢ root.count [a ↦ a]
    enforced root.label.foreignKey a b := root.label [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.X []
    monitored root.label.total a := a ∈ root.X [] ⊢ root.label [a ↦ a]
    monitored root.countIs19 x a := x ∈ root.X [] ∧ root.count [
      a ↦ x,
      b ↦ a
    ] ⊢ a = 19
    monitored root.labelIsZombocom x a := x ∈ root.X [] ∧ root.label [
      a ↦ x,
      b ↦ a
    ] ⊢ a = "zombocom"
  end
end

-- messages
