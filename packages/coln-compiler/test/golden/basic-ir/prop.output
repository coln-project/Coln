-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  V : Prop
end
realm named TRealm
elaborated: realm
  generators
    node
      V = rel []
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.V := [] primarykey []
  end
  rules
    enforced ℜ.V.foreignKey := ℜ.V [] ⊢ ⊤
  end
end

-- messages
