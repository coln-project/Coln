-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Set
  E : (x : A) -> B x -> Set
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end

realm named TRealm

```flir
('root.A (ground ()))
('root.B (ground ((%a 'root.A))))
('root.E (ground ((%x 'root.A) (%a 'root.B))))
('root.next (ground ((%x 'root.A) (%a 'root.B)) (primarykey 1)))
('root.nextedge (ground ((%x 'root.A) (%a 'root.E)) (primarykey 1)))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey
 (law enforced ((%a 'root.A)) (('root.B %a)) (('root.A (id %a)))))
('root.E.foreignKey
 (law
  enforced
  ((%x 'root.A) (%a 'root.B))
  (('root.E %x %a))
  (('root.A (id %x)) ('root.B (id %a) %x))))
('root.next.foreignKey
 (law
  enforced
  ((%x 'root.A) (%a 'root.B))
  (('root.next %x %a))
  (('root.A (id %x)) ('root.B (id %a) %x))))
('root.next.total
 (law monitored ((%x 'root.A)) (('root.A (id %x))) (('root.next %x))))
('root.nextedge.foreignKey
 (law
  enforced
  ((%x 'root.A) (%a 'root.E) (%b 'root.B))
  (('root.next %x %b) ('root.nextedge %x %a))
  (('root.A (id %x)) ('root.E (id %a) %x %b))))
('root.nextedge.total
 (law monitored ((%x 'root.A)) (('root.A (id %x))) (('root.nextedge %x))))
