-- elaborated
global entry named Box
in mode: Conjunctive
type: (X : Set) -> (E : X -> Set) -> Set
value: X => E => sig
  value : X
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  E : Int -> Set
  boxed : Box Int E -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.E := [a : Int]
    table root.boxed := [a.value : Int]
  end
  definitions
  end
  rules
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ ⊤
    enforced root.boxed.foreignKey a.value := root.boxed [a.value ↦ a.value] ⊢ ⊤
  end
end

-- messages
