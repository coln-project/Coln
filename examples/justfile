mod coln-compiler-wasm '../packages/coln-compiler-wasm'
mod coln-js-runtime '../packages/coln-js-runtime'

store_dir := "${PNPM_STORE_DIR:-$(realpath ..)/.pnpm-store}"

# Every package builds straight in to its own slot under `_build/web`, so
# there's nothing to assemble afterwards.

# the whole site: both demos and the landing page
build-web: build-web-compiler build-web-sync build-web-index

# the whole site, in a browser
serve-web *args: build-web
    pnpm --filter coln-demos exec vite preview --open {{ args }}

install-web-index:
    pnpm install --filter coln-demos --store-dir "{{ store_dir }}"

# the landing page linking the demos together
build-web-index: install-web-index
    pnpm --filter coln-demos run build

# `pnpm install` has to come after the Wasm build, since the compiler demo
# depends on the NPM package it produces. `--filter` keeps the other packages,
# whose dependencies are irrelevant here, out of it.

install-web-compiler: coln-compiler-wasm::npm-package
    pnpm install --filter coln-compiler-demo --store-dir "{{ store_dir }}"

# the compiler playground
build-web-compiler: install-web-compiler
    pnpm --filter coln-compiler-demo run build

# the compiler playground, in a browser, with hot reloading
serve-web-compiler *args: install-web-compiler
    pnpm --filter coln-compiler-demo exec vite --open {{ args }}

# The sync demo links against `coln-js-runtime`, which is itself built from
# Rust, and its own build step compiles `graph.coln` with the Coln CLI.

install-web-sync: coln-js-runtime::install coln-js-runtime::build
    pnpm install --filter coln-sync-demo --store-dir "{{ store_dir }}"

# the store sync demo
build-web-sync: install-web-sync
    pnpm --filter coln-sync-demo run build

# the store sync demo, in a browser, with hot reloading
serve-web-sync *args: install-web-sync
    pnpm --filter coln-sync-demo exec vite --open {{ args }}
