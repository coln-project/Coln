-- elaborated
global entry named Pair
in mode: Conjunctive
type: Set
value: sig
  first : Int
  second : Int
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  E : Int -> Int -> Set
  R : (p : Pair) -> E p.second p.first -> Set
end

realm named TRealm

```flir
('root.E (table (ground) ((%a int) (%b int))))
('root.R (table (ground) ((%p.first int) (%p.second int) (%a 'root.E))))
('root.E.foreignKey (law enforced ((%a int) (%b int)) (('root.E %a %b)) ()))
('root.R.foreignKey
 (law
  enforced
  ((%p.first int) (%p.second int) (%a 'root.E))
  (('root.R %p.first %p.second %a))
  (('root.E (id %a) %p.second %p.first))))
```

