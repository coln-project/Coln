-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Prop
  Y : Set
  next : X -> Y
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := [] primarykey []
    table root.Y := []
    table root.next := [b : root.Y] primarykey []
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.Y.foreignKey := root.Y [] ⊢ ⊤
    enforced root.next.foreignKey b := root.next [
      b ↦ b
    ] ⊢ root.X [] ∧ b ∈ root.Y []
    monitored root.next.total := root.X [] ⊢ root.next []
  end
end

-- messages
