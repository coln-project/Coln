-- elaborated
global entry named Witness
in mode: Conjunctive
type: (X : Set) -> (x : X) -> Set
value: X => x => sig
  proof : x = x
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  witness : (x : X) -> Witness X x
end
realm named TRealm
elaborated: realm
  generators
    node
      X = rel []
      witness = (fun [x : TRealm.X []] -> Witness (TRealm.X []) x)
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.X := []
  end
  rules
    enforced ℜ.X.foreignKey := ℜ.X [] ⊢ ⊤
    monitored ℜ.witness x := x ∈ ℜ.X [] ⊢ x = x
  end
end

-- messages
