-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Prop
  E : (x : A) -> B x -> Prop
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end
realm named TRealm
elaborated: realm
  generators
    node
      A = rel []
      B = rel [a : TRealm.A []]
      E = rel [x : TRealm.A [], a : TRealm.B [a := x]]
      next = (fun [x : TRealm.A []] -> TRealm.B [a := x])
      nextedge = (fun [x : TRealm.A []] -> TRealm.E [
        x := x,
        a := TRealm.next [x := x]
      ])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.A := [] primarykey []
    table ℜ.B := [] primarykey []
    table ℜ.E := [] primarykey []
    table ℜ.next := [] primarykey []
    table ℜ.nextedge := [] primarykey []
  end
  rules
    enforced ℜ.A.foreignKey := ℜ.A [] ⊢ ⊤
    enforced ℜ.B.foreignKey := ℜ.B [] ⊢ ℜ.A []
    enforced ℜ.E.foreignKey := ℜ.E [] ⊢ ℜ.A [] ∧ ℜ.B []
    enforced ℜ.next.foreignKey := ℜ.next [] ⊢ ℜ.A [] ∧ ℜ.B []
    monitored ℜ.next.total := ℜ.A [] ⊢ ℜ.next []
    enforced ℜ.nextedge.foreignKey := ℜ.nextedge [] ∧ ℜ.next [] ⊢ ℜ.A [] ∧ ℜ.E []
    monitored ℜ.nextedge.total := ℜ.A [] ⊢ ℜ.nextedge []
  end
end

-- messages
