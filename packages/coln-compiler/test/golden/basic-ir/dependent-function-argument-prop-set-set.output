-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Set
  C : (a : A) -> B a -> Set
  f : (a : A) -> (b : B a) -> C a b
end

realm named TRealm

```flir
('root.A (table (ground (primarykey 0)) ()))
('root.B (table (ground) ()))
('root.C (table (ground) ((%b 'root.B))))
('root.f (table (ground (primarykey 1)) ((%b 'root.B) (%c 'root.C))))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey (law enforced () (('root.B)) (('root.A))))
('root.C.foreignKey
 (law enforced ((%b 'root.B)) (('root.C %b)) (('root.A) ('root.B (id %b)))))
('root.f.foreignKey
 (law
  enforced
  ((%b 'root.B) (%c 'root.C))
  (('root.f %b %c))
  (('root.A) ('root.B (id %b)) ('root.C (id %c) %b))))
('root.f.total
 (law monitored ((%b 'root.B)) (('root.A) ('root.B (id %b))) (('root.f %b))))
