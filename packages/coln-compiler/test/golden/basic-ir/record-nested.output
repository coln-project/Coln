-- elaborated
global entry named Inner
in mode: Conjunctive
type: Set
value: sig
  rank : Int
end
global entry named Outer
in mode: Conjunctive
type: Set
value: sig
  name : String
  inner : Inner
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  payload : Outer
end
realm named TRealm
lowered: flatrealm
  entities
    table root := [
      a.payload.name : String,
      a.payload.inner.rank : Int
    ] primarykey []
  end
  definitions
  end
  rules
    enforced root.foreignKey a.payload.name a.payload.inner.rank := root [
      a.payload.name ↦ a.payload.name,
      a.payload.inner.rank ↦ a.payload.inner.rank
    ] ⊢ ⊤
    monitored root.total := ⊤ ⊢ root []
  end
end

-- messages
