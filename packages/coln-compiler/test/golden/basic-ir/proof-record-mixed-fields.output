-- elaborated
global entry named EqualTriple
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  first : X
  second : X
  proof : first = second
  trailing : X
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  value : EqualTriple X
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.value := [
      a.first : root.X,
      a.second : root.X,
      a.trailing : root.X
    ] primarykey []
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.value.foreignKey a.first a.second a.trailing := root.value [
      a.first ↦ a.first,
      a.second ↦ a.second,
      a.trailing ↦ a.trailing
    ] ⊢ a.first ∈ root.X [] ∧ a.second ∈ root.X [] ∧ a.first = a.second ∧ a.trailing ∈ root.X []
    monitored root.value.total := ⊤ ⊢ root.value []
  end
end

-- messages
