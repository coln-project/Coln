-- elaborated
global entry named Clauses
in mode: Conjunctive
type: (X : Set) -> Theory
value: X => sig
  clause : Set
  appears-pos : clause -> X -> Prop
  appears-neg : clause -> X -> Prop
end

global entry named Clauses/hom
in mode: Conjunctive
type: (X : Set) -> (C0 : Clauses X) -> (C1 : Clauses X) -> Theory
value: X => C0 => C1 => sig
  clause : C0.clause -> C1.clause
  appears-pos : (c : C0.clause) -> (v : X) -> C0.appears-pos c v -> C1.appears-pos (clause c) v
  appears-neg : (c : C0.clause) -> (v : X) -> C0.appears-neg c v -> C1.appears-neg (clause c) v
end

global entry named SATProblem
in mode: Conjunctive
type: Theory
value: sig
  var : Set
  neq : var -> var -> Prop
  c : Clauses var
end

global entry named ResolvedClause
in mode: Conjunctive
type: (X : Set) -> (neq : X -> X -> Prop) -> (D : Clauses X) -> (c0 : D.clause) -> (c1 : D.clause) -> (v : X) -> Theory
value: X => neq => D => c0 => c1 => v => sig
  c : D.clause
  pos0 : (w : X) -> neq w v -> D.appears-pos c0 w -> D.appears-pos c w
  pos1 : (w : X) -> neq w v -> D.appears-pos c1 w -> D.appears-pos c w
  neg0 : (w : X) -> neq w v -> D.appears-neg c0 w -> D.appears-neg c w
  neg1 : (w : X) -> neq w v -> D.appears-neg c1 w -> D.appears-neg c w
end

global entry named DerivedClause/motive
in mode: Conjunctive
type: (I : SATProblem) -> Theory
value: I => sig
  D : Clauses I.var
  incl : Clauses/hom I.var I.c D
  resolve : (c0 : D.clause) -> (c1 : D.clause) -> (v : I.var) -> D.appears-pos c0 v -> D.appears-neg c1 v -> ResolvedClause I.var I.neq D c0 c1 v
end

