-- elaborated
global entry named Cocone
in mode: Conjunctive
type: (a : Set) -> (b : Set) -> Theory
value: a => b => sig
  apex : Set
  inl : a -> apex
  inr : b -> apex
end
global entry named Either/cocone
in mode: Inductive
type: (a : Set) -> (b : Set) -> Cocone a b
value: a => b => init (Cocone a b)
global entry named Either
in mode: Inductive
type: (a : Set) -> (b : Set) -> Set
value: a => b => Either/cocone a b .apex

