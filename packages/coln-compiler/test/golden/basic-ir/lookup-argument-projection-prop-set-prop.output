-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Set
  E : (x : A) -> B x -> Prop
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end

realm named TRealm

```flir
('root.A (ground () (primarykey 0)))
('root.B (ground ()))
('root.E (ground ((%a 'root.B)) (primarykey 1)))
('root.next (ground ((%a 'root.B)) (primarykey 0)))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey (law enforced () (('root.B)) (('root.A))))
('root.E.foreignKey
 (law enforced ((%a 'root.B)) (('root.E %a)) (('root.A) ('root.B (id %a)))))
('root.next.foreignKey
 (law enforced ((%a 'root.B)) (('root.next %a)) (('root.A) ('root.B (id %a)))))
('root.next.total (law monitored () (('root.A)) (('root.next))))
('root.nextedge
 (law monitored ((%a 'root.B)) (('root.next %a) ('root.A)) (('root.E %a))))
```

