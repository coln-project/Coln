-- elaborated
global entry named Box
in mode: Conjunctive
type: (X : Set) -> (x : X) -> (E : X -> Set) -> Set
value: X => x => E => sig
  value : E x
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  boxed : (x : Int) -> Box Int x (y => String) -> Set
end

realm named TRealm

```flir
('root.boxed (ground ((%x int) (%a.value string))))
('root.boxed.foreignKey
 (law enforced ((%x int) (%a.value string)) (('root.boxed %x %a.value)) ()))
```

