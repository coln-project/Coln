-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  P : Prop
  x : P
  y : P
  eq : x = y
end
realm named TRealm
lowered: flatrealm
  entities
    table root.P := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.P.foreignKey := root.P [] ⊢ ⊤
    monitored root.x := ⊤ ⊢ root.P []
    monitored root.y := ⊤ ⊢ root.P []
  end
end

-- messages
