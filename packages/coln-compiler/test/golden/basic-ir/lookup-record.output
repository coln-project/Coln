-- elaborated
global entry named Payload
in mode: Conjunctive
type: Set
value: sig
  name : String
  rank : Int
end

global entry named fixed
in mode: Conjunctive
type: Payload
value: [name := "fixed", rank := 1]

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  E : Payload -> Set
  selected : E fixed
end

realm named TRealm

```flir
('root.E (ground ((%a.name string) (%a.rank int))))
('root.selected (ground ((%a 'root.E)) (primarykey 0)))
('root.E.foreignKey
 (law enforced ((%a.name string) (%a.rank int)) (('root.E %a.name %a.rank)) ()))
('root.selected.foreignKey
 (law
  enforced
  ((%a 'root.E))
  (('root.selected %a))
  (('root.E (id %a) "fixed" 1))))
('root.selected.total (law monitored () () (('root.selected))))
```

