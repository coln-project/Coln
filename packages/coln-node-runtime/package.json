{
  "name": "@coln-project/node-runtime",
  "napi": {
    "binaryName": "coln-node-runtime"
  },
  "type": "module",
  "scripts": {
    "build-runtime": "napi build --platform --esm --release -o native",
    "build-runtime:debug": "napi build --platform --esm -o native",
    "generate-bindings": "cabal run coln-cli -- generate-ts test/definitions.coln -o test",
    "test": "tsc; cabal run coln-cli -- generate-ir test/definitions.coln -o dist/test; node dist/test/main.js"
  },
  "dependencies": {
    "@coln-project/interface": "link:../coln-js-interface"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^26.6.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
