-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  V : Set
  count : V -> Int
  label : V -> String
end
realm named TRealm
lowered: flatrealm
  entities
    table root.V := []
    table root.count := [a : root.V, b : Int] primarykey [a]
    table root.label := [a : root.V, b : String] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.V.foreignKey := root.V [] ⊢ ⊤
    enforced root.count.foreignKey a b := root.count [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.V []
    monitored root.count.total a := a ∈ root.V [] ⊢ root.count [a ↦ a]
    enforced root.label.foreignKey a b := root.label [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.V []
    monitored root.label.total a := a ∈ root.V [] ⊢ root.label [a ↦ a]
  end
end

-- messages
