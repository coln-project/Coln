-- elaborated
global entry named Key
in mode: Conjunctive
type: Set
value: sig
  rank : Int
end

global entry named Payload
in mode: Conjunctive
type: Set
value: sig
  name : String
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  key : X -> Key
  PayloadAt : Int -> Set
  slot : (x : X) -> PayloadAt (key x .rank)
  payload : (rank : Int) -> PayloadAt rank -> Payload
  E : String -> Set
  edge : (x : X) -> E (payload (key x .rank) (slot x) .name)
end

realm named TRealm

