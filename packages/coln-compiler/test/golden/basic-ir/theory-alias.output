-- elaborated
global entry named Base
in mode: Conjunctive
type: Theory
value: sig
  X : Set
end
global entry named Alias
in mode: Conjunctive
type: Theory
value: Base
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
  end
end

-- messages
