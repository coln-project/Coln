-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  IntEdge : Int -> Set
  StringEdge : String -> Set
  intEdge : IntEdge 19
  stringEdge : StringEdge "zombocom"
end
realm named TRealm
lowered: flatrealm
  entities
    table root.IntEdge := [a : Int]
    table root.StringEdge := [a : String]
    table root.intEdge := [a : root.IntEdge] primarykey []
    table root.stringEdge := [a : root.StringEdge] primarykey []
  end
  definitions
  end
  rules
    enforced root.IntEdge.foreignKey a := root.IntEdge [a ↦ a] ⊢ ⊤
    enforced root.StringEdge.foreignKey a := root.StringEdge [a ↦ a] ⊢ ⊤
    enforced root.intEdge.foreignKey a := root.intEdge [
      a ↦ a
    ] ⊢ a ∈ root.IntEdge [a ↦ 19]
    monitored root.intEdge.total := ⊤ ⊢ root.intEdge []
    enforced root.stringEdge.foreignKey a := root.stringEdge [
      a ↦ a
    ] ⊢ a ∈ root.StringEdge [a ↦ "zombocom"]
    monitored root.stringEdge.total := ⊤ ⊢ root.stringEdge []
  end
end

-- messages
