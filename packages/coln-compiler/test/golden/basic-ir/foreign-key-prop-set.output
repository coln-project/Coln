-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  V : Prop
  E : V -> Set
end
realm named TRealm
elaborated: realm
  generators
    node
      V = rel []
      E = rel [a : TRealm.V []]
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.V := [] primarykey []
    table ℜ.E := []
  end
  rules
    enforced ℜ.V.foreignKey := ℜ.V [] ⊢ ⊤
    enforced ℜ.E.foreignKey := ℜ.E [] ⊢ ℜ.V []
  end
end

-- messages
