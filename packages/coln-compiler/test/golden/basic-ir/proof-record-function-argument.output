-- elaborated
global entry named EqualTriple
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  first : X
  second : X
  proof : first = second
  trailing : X
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  Accepted : EqualTriple X -> Prop
end

realm named TRealm

```flir
('root.X (ground ()))
('root.Accepted
 (ground
  ((%a.first 'root.X) (%a.second 'root.X) (%a.trailing 'root.X))
  (primarykey 3)))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.Accepted.foreignKey
 (law
  enforced
  ((%a.first 'root.X) (%a.second 'root.X) (%a.trailing 'root.X))
  (('root.Accepted %a.first %a.second %a.trailing))
  (('root.X (id %a.first))
   ('root.X (id %a.second))
   (= 'root.X %a.first %a.second)
   ('root.X (id %a.trailing)))))
```

