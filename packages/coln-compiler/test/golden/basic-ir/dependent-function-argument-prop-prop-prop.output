-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Prop
  C : (a : A) -> B a -> Prop
  f : (a : A) -> (b : B a) -> C a b
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := [] primarykey []
    table root.C := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ root.A []
    enforced root.C.foreignKey := root.C [] ⊢ root.A [] ∧ root.B []
    monitored root.f := root.A [] ∧ root.B [] ⊢ root.C []
  end
end

-- messages
