-- elaborated
global entry named Slice
in mode: Conjunctive
type: (Y : Set) -> (S : Y -> Set) -> (y : Y) -> Set
value: Y => S => y => sig
  entry : S y
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  Y : Set
  R : X -> Y -> Set
  slices : (x : X) -> (y : Y) -> Slice Y (R x) y -> Set
end

realm named TRealm

```flir
('root.X (ground ()))
('root.Y (ground ()))
('root.R (ground ((%a 'root.X) (%b 'root.Y))))
('root.slices (ground ((%x 'root.X) (%y 'root.Y) (%a.entry 'root.R))))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.Y.foreignKey (law enforced () (('root.Y)) ()))
('root.R.foreignKey
 (law
  enforced
  ((%a 'root.X) (%b 'root.Y))
  (('root.R %a %b))
  (('root.X (id %a)) ('root.Y (id %b)))))
('root.slices.foreignKey
 (law
  enforced
  ((%x 'root.X) (%y 'root.Y) (%a.entry 'root.R))
  (('root.slices %x %y %a.entry))
  (('root.X (id %x)) ('root.Y (id %y)) ('root.R (id %a.entry) %x %y))))
```

