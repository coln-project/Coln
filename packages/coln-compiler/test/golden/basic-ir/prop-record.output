-- elaborated
global entry named And
in mode: Conjunctive
type: (P : Prop) -> (Q : Prop) -> Prop
value: P => Q => sig
  left : P
  right : Q
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  P : Prop
  Q : Prop
  make : P -> Q -> And P Q
  projectLeft : And P Q -> P
end
realm named TRealm
elaborated: realm
  generators
    node
      P = rel []
      Q = rel []
      make = (fun [
        a : TRealm.P [],
        b : TRealm.Q []
      ] -> And (TRealm.P []) (TRealm.Q []))
      projectLeft = (fun [a : And (TRealm.P []) (TRealm.Q [])] -> TRealm.P [])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.P := [] primarykey []
    table ℜ.Q := [] primarykey []
    table ℜ.make := [] primarykey []
    table ℜ.projectLeft := [] primarykey []
  end
  rules
    enforced ℜ.P.foreignKey := ℜ.P [] ⊢ ⊤
    enforced ℜ.Q.foreignKey := ℜ.Q [] ⊢ ⊤
    enforced ℜ.make.foreignKey := ℜ.make [] ⊢ ℜ.P [] ∧ ℜ.Q [] ∧ ℜ.P [] ∧ ℜ.Q []
    monitored ℜ.make.total := ℜ.P [] ∧ ℜ.Q [] ⊢ ℜ.make []
    enforced ℜ.projectLeft.foreignKey := ℜ.projectLeft [] ⊢ ℜ.P [] ∧ ℜ.Q [] ∧ ℜ.P []
    monitored ℜ.projectLeft.total := ℜ.P [] ∧ ℜ.Q [] ⊢ ℜ.projectLeft []
  end
end

-- messages
