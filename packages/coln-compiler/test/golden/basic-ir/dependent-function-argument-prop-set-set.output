-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Set
  C : (a : A) -> B a -> Set
  f : (a : A) -> (b : B a) -> C a b
end

realm named TRealm

```flir
('root.A (ground () (primarykey 0)))
('root.B (ground ()))
('root.C (ground ((%b 'root.B))))
('root.f (ground ((%b 'root.B) (%c 'root.C)) (primarykey 1)))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey (law enforced () (('root.B)) (('root.A))))
('root.C.foreignKey
 (law enforced ((%b 'root.B)) (('root.C %b)) (('root.A) ('root.B (id %b)))))
('root.f.foreignKey
 (law
  enforced
  ((%b 'root.B) (%c 'root.C))
  (('root.f %b %c))
  (('root.A) ('root.B (id %b)) ('root.C (id %c) %b))))
('root.f.total
 (law monitored ((%b 'root.B)) (('root.A) ('root.B (id %b))) (('root.f %b))))
```

