-- elaborated
global entry named Payload
in mode: Conjunctive
type: Set
value: sig
  name : String
  rank : Int
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  point : Set
  payload : point -> Payload
end
realm named TRealm
lowered: flatrealm
  entities
    table root.point := []
    table root.payload := [
      a : root.point,
      b.name : String,
      b.rank : Int
    ] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.point.foreignKey := root.point [] ⊢ ⊤
    enforced root.payload.foreignKey a b.name b.rank := root.payload [
      a ↦ a,
      b.name ↦ b.name,
      b.rank ↦ b.rank
    ] ⊢ a ∈ root.point []
    monitored root.payload.total a := a ∈ root.point [] ⊢ root.payload [a ↦ a]
  end
end

-- messages
