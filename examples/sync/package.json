{
  "name": "coln-sync",
  "private": true,
  "type": "module",
  "license": "(Apache-2.0 OR MIT)",
  "scripts": {
    "dev": "coln-with-sync-server vite --host 127.0.0.1",
    "cli": "coln-with-sync-server tsx src/cli/main.tsx",
    "server": "coln-sync-server",
    "compile": "bash ./compile.sh",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "build": "pnpm run compile && pnpm run check && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@automerge/automerge-repo": "github:automerge/automerge-repo#doctypes&path:packages/automerge-repo",
    "@automerge/automerge-repo-storage-indexeddb": "2.6.0-subduction.47",
    "@automerge/automerge-subduction": "0.16.1",
    "@coln-project/repo": "link:../../packages/coln-repo",
    "@coln-project/runtime": "link:../../packages/coln-js-runtime",
    "ink": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.0.0",
    "svelte": "^5.7.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@coln-project/demo-sync-server": "file:../sync-server",
    "@playwright/test": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@vitest/browser-playwright": "^4.1.11",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.0",
    "vite": "^8.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11"
  }
}
