-- elaborated
global entry named Evidence
in mode: Conjunctive
type: (P : Prop) -> Set
value: P => sig
  proof : P
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  P : Prop
  evidence : Evidence P
end
realm named TRealm
elaborated: realm
  generators
    node
      P = rel []
      evidence = (fun [] -> Evidence (TRealm.P []))
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.P := [] primarykey []
  end
  rules
    enforced ℜ.P.foreignKey := ℜ.P [] ⊢ ⊤
    monitored ℜ.evidence := ⊤ ⊢ ℜ.P []
  end
end

-- messages
