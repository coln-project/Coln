-- elaborated
global entry named Pair
in mode: Conjunctive
type: Set
value: sig
  first : Int
  second : Int
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  E : Int -> Int -> Set
  R : (p : Pair) -> E p.second p.first -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.E := [a : Int, b : Int]
    table root.R := [p.first : Int, p.second : Int, a : root.E]
  end
  definitions
  end
  rules
    enforced root.E.foreignKey a b := root.E [a ↦ a, b ↦ b] ⊢ ⊤
    enforced root.R.foreignKey p.first p.second a := root.R [
      p.first ↦ p.first,
      p.second ↦ p.second,
      a ↦ a
    ] ⊢ a ∈ root.E [a ↦ p.second, b ↦ p.first]
  end
end

-- messages
