-- elaborated
global entry named PointOf
in mode: Conjunctive
type: (X : Set) -> Theory
value: X => sig
  point : X
end
global entry named Key
in mode: Conjunctive
type: Set
value: sig
  rank : Int
end
global entry named Box
in mode: Conjunctive
type: (X : Set) -> (p : PointOf X) -> (Y : Set) -> Set
value: X => p => Y => sig
  key : X
  value : Y
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  pointed : PointOf Key
  boxed : Box Key pointed String -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.pointed := [a.point.rank : Int] primarykey []
    table root.boxed := [a.key.rank : Int, a.value : String]
  end
  definitions
  end
  rules
    enforced root.pointed.foreignKey a.point.rank := root.pointed [
      a.point.rank ↦ a.point.rank
    ] ⊢ ⊤
    monitored root.pointed.total := ⊤ ⊢ root.pointed []
    enforced root.boxed.foreignKey a.key.rank a.value := root.boxed [
      a.key.rank ↦ a.key.rank,
      a.value ↦ a.value
    ] ⊢ ⊤
  end
end

-- messages
