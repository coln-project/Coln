\title{Prelude}

\p{This file contains the definition of macros used throughout the Coln manual.}

\def\defcase[x]{\strong{\x}}

\def\table[head][body]{\<html:table>{\<html:thead>{\head}\<html:tbody>{\body}}}

\def\row[cells]{\<html:tr>{\cells}}
\def\cell[content]{\<html:td>{\content}}
\def\hcell[content]{\<html:th>{\content}}

\def\collapsedaside[~body]{
  \scope{
    \put\transclude/expanded{false}
    \put\transclude/toc{false}
    \put\transclude/numbered{false}
    \subtree{\body{}}
  }
}

\def\dbexample[body]{
  \collapsedaside{
    \taxon{Example Instance}
    \<html:div>[class]{database-example}{\body}
  }
}

\def\todo{\<html:sup>[class]{smallcaps}{todo}}
\def\kw[x]{\strong{\x}}

\def\ms[t]{\mathsf{\t}}
\def\mb[t]{\mathbf{\t}}
\def\mc[t]{\mathcal{\t}}
\def\bb[t]{\mathbb{\t}}
\def\op{^\mathrm{op}}
\def\groth{{\textstyle\int}}
\def\ext{\triangleright}

\def\check{✅}

\def\To{\Rightarrow}

\def\mvrnote[~body]{\<html:span>[style]{color: blue;}{MVRNOTE: \body{}}}

\def\lvl[name]{\mathfrak{\name}}
