-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : Set
  E : B -> Prop
  x : A
  next : A -> B
  edge : E (next x)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := []
    table root.E := [a : root.B] primarykey [a]
    table root.x := [a : root.A] primarykey []
    table root.next := [a : root.A, b : root.B] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ ⊤
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ a ∈ root.B []
    enforced root.x.foreignKey a := root.x [a ↦ a] ⊢ a ∈ root.A []
    monitored root.x.total := ⊤ ⊢ root.x []
    enforced root.next.foreignKey a b := root.next [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.A [] ∧ b ∈ root.B []
    monitored root.next.total a := a ∈ root.A [] ⊢ root.next [a ↦ a]
    monitored root.edge a b := root.x [a ↦ b] ∧ root.next [
      a ↦ b,
      b ↦ a
    ] ⊢ root.E [a ↦ a]
  end
end

-- messages
