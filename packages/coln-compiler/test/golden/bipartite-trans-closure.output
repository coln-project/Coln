   ('root.blue-red (id %a) %v0 %w0)
   ('init.connection-info.red-red %w0 %w1)
   ('root.red-blue (id %c) %w1 %v1))
  ('init.connection-info.blue-blue %v0 %v1)))
('root.red.foreignKey (law enforced () (('root.red)) ()))
('root.blue.foreignKey (law enforced () (('root.blue)) ()))
('root.red-blue.foreignKey
 (law
