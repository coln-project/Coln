-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Prop
  Y : Prop
  next : X -> Y
end
realm named TRealm
elaborated: realm
  generators
    node
      X = rel []
      Y = rel []
      next = (fun [a : TRealm.X []] -> TRealm.Y [])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.X := [] primarykey []
    table ℜ.Y := [] primarykey []
    table ℜ.next := [] primarykey []
  end
  rules
    enforced ℜ.X.foreignKey := ℜ.X [] ⊢ ⊤
    enforced ℜ.Y.foreignKey := ℜ.Y [] ⊢ ⊤
    enforced ℜ.next.foreignKey := ℜ.next [] ⊢ ℜ.X [] ∧ ℜ.Y []
    monitored ℜ.next.total := ℜ.X [] ⊢ ℜ.next []
  end
end

-- messages
