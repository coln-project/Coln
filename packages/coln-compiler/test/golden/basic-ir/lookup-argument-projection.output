-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Set
  E : (x : A) -> B x -> Set
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [a : root.A]
    table root.E := [x : root.A, a : root.B]
    table root.next := [x : root.A, a : root.B] primarykey [x]
    table root.nextedge := [x : root.A, a : root.E] primarykey [x]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey a := root.B [a ↦ a] ⊢ a ∈ root.A []
    enforced root.E.foreignKey x a := root.E [
      x ↦ x,
      a ↦ a
    ] ⊢ x ∈ root.A [] ∧ a ∈ root.B [a ↦ x]
    enforced root.next.foreignKey x a := root.next [
      x ↦ x,
      a ↦ a
    ] ⊢ x ∈ root.A [] ∧ a ∈ root.B [a ↦ x]
    monitored root.next.total x := x ∈ root.A [] ⊢ root.next [x ↦ x]
    enforced root.nextedge.foreignKey x a b := root.nextedge [
      x ↦ x,
      a ↦ a
    ] ⊢ x ∈ root.A [] ∧ root.next [x ↦ x, a ↦ b] ∧ a ∈ root.E [x ↦ x, a ↦ b]
    monitored root.nextedge.total x := x ∈ root.A [] ⊢ root.nextedge [x ↦ x]
  end
end

-- messages
