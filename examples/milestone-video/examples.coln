theory Graph := sig
  vertex : Set
  edge : vertex -> vertex -> Set
end

theory GraphWithNames := sig
  graph : Graph
  vertex-name : graph.vertex -> String
  edge-name : (v0 v1 : graph.vertex) -> graph.edge v0 v1 -> String
end

theory NamedSet := sig
  elt : Set
  name : elt -> String
end

theory GraphOverNamedSets := sig
  vertex : NamedSet
  edge : vertex.elt -> vertex.elt -> NamedSet
end

theory TransitiveExtension (^i G : Graph) := sig
  rel : G.vertex -> G.vertex -> Prop
  incl : (a b : G.vertex) -> G.edge a b -> rel a b
  trans : (a b c : G.vertex) -> rel a b -> rel b c -> rel a c
end

theory MonoidOn (X : Set) := sig
  zero : X
  plus : X -> X -> X
end

theory FlowExprInterface (^i G : Graph) := sig
  t : G.vertex -> Set
  is-monoid : MonoidOn t
  const : (v : G.vertex) -> Int -> t v
  flow : (a b : G.vertex) -> G.edge a b -> t b
end

realm GraphRealm @ GraphOverNamedSets
  def graph-with-names : GraphWithNames := struct
    graph := struct
      vertex := root.vertex.elt
      edge := v0 => v1 => (root.edge v0 v1).elt
    end
    vertex-name := root.vertex.name
    edge-name := v0 => v1 => (root.edge v0 v1).name
  end

  def g : Graph := graph-with-names.graph

  ind def trans-closure : TransitiveExtension g := init (TransitiveExtension g)

  ind def FlowExpr : FlowExprInterface g := init (FlowExprInterface g)
end

