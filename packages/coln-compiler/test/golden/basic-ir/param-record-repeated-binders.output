-- elaborated
global entry named Shadowed
in mode: Conjunctive
type: (X : Set) -> (X : Set) -> Set
value: X => X => sig
  value : X
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : Set
  shadowed : Shadowed A B -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := []
    table root.shadowed := [a.value : root.B]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ ⊤
    enforced root.shadowed.foreignKey a.value := root.shadowed [
      a.value ↦ a.value
    ] ⊢ a.value ∈ root.B []
  end
end

-- messages
