-- elaborated
global entry named Box
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  value : X
end
global entry named Nested
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  inner : Box X
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  nested : Nested X -> Set
end
realm named TRealm
elaborated: realm
  generators
    node
      X = rel []
      nested = rel [a : Nested (TRealm.X [])]
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.X := []
    table ℜ.nested := [.a.inner.value : ℜ.X]
  end
  rules
    enforced ℜ.X.foreignKey := ℜ.X [] ⊢ ⊤
    enforced ℜ.nested.foreignKey a.inner.value := ℜ.nested [
      .a.inner.value ↦ a.inner.value
    ] ⊢ a.inner.value ∈ ℜ.X []
  end
end

-- messages
