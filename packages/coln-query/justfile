# Task runner: https://github.com/casey/just

crate := "coln-query"

# List all just targets.
default:
    @just --list

# Auto fix code formatting.
fmt:
    cargo fmt -p {{ crate }}

# Check code formatting.
fmt-check:
    cargo fmt -p {{ crate }} --check

# Auto fix linting issues.
lint:
    cargo fix -p {{ crate }} --all-targets --all-features --allow-dirty --allow-staged
    cargo clippy -p {{ crate }} --fix --all-targets --all-features --allow-dirty --allow-staged -- -D warnings

# Check linting.
lint-check:
    cargo check -p {{ crate }} --all-targets --all-features
    cargo clippy -p {{ crate }} --all-targets --all-features -- -D warnings

# Run tests with stdout and stderr suppressed.
test *TESTS:
    cargo nextest run -p {{ crate }} --all-targets --no-fail-fast {{ TESTS }}
    # As of now nextest does not support doc tests, so we fallback to
    # cargo test to run them.
    cargo test --doc -p {{ crate }} {{ TESTS }}

alias t := test-verbose
# Run tests but with stdout and stderr printed.
test-verbose *TESTS:
    cargo nextest run -p {{ crate }} --all-targets --nocapture {{ TESTS }}

# Dump tests' artefacts into target/test_artefacts and render any graphviz graph
# as SVG. Renders even if tests fail, as those are the ones worth a look, but
# exits with the tests' status.
test-dump *TESTS:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v dot > /dev/null || { echo "dot not found: enter the dev shell, which has graphviz" >&2; exit 1; }
    status=0
    COLN_QUERY_TEST_DUMP=1 cargo nextest run -p {{ crate }} --all-targets --no-fail-fast {{ TESTS }} || status=$?
    target="$(cargo metadata --format-version 1 --no-deps | jq -r .target_directory)"
    shopt -s nullglob
    for graph in "$target"/test_artefacts/*/*.dot; do
        dot -Tsvg "$graph" -o "${graph%.dot}.svg"
        echo "rendered ${graph%.dot}.svg"
    done
    exit "$status"

# Build the docs.
doc:
    cargo doc -p {{ crate }}

# Check the docs for broken links.
doc-check:
    cargo doc -p {{ crate }} --no-deps --document-private-items --config 'build.rustdocflags=["-D", "warnings"]'

alias c := check
# Run all code checks. Global command referenced by the root justfile.
check: fmt-check lint-check test doc-check

# Run all automated code fixes. Global command referenced by the root justfile.
fix: fmt lint

# Define what to do in the CI pipeline.
ci: check

# Test coverage.
coverage:
    cargo llvm-cov -p {{ crate }} --cobertura --output-path cobertura.xml

alias b := build
# Build the crate with all features and targets.
build:
    cargo build -p {{ crate }} --all-targets --all-features

# Run the crate.
run:
    cargo run -p {{ crate }}
