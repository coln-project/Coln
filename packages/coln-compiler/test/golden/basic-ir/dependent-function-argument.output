-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Set
  C : (a : A) -> B a -> Set
  f : (a : A) -> (b : B a) -> C a b
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [a : root.A]
    table root.C := [a : root.A, b : root.B]
    table root.f := [a : root.A, b : root.B, c : root.C] primarykey [a, b]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey a := root.B [a ↦ a] ⊢ a ∈ root.A []
    enforced root.C.foreignKey a b := root.C [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.A [] ∧ b ∈ root.B [a ↦ a]
    enforced root.f.foreignKey a b c := root.f [
      a ↦ a,
      b ↦ b,
      c ↦ c
    ] ⊢ a ∈ root.A [] ∧ b ∈ root.B [a ↦ a] ∧ c ∈ root.C [a ↦ a, b ↦ b]
    monitored root.f.total a b := a ∈ root.A [] ∧ b ∈ root.B [a ↦ a] ⊢ root.f [
      a ↦ a,
      b ↦ b
    ]
  end
end

-- messages
