-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : Prop
  C : Prop
  E : C -> Prop
  first : A -> B
  second : B -> C
  edge : (x : A) -> E (second (first x))
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := [] primarykey []
    table root.C := [] primarykey []
    table root.E := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ ⊤
    enforced root.C.foreignKey := root.C [] ⊢ ⊤
    enforced root.E.foreignKey := root.E [] ⊢ root.C []
    monitored root.first := root.A [] ⊢ root.B []
    monitored root.second := root.B [] ⊢ root.C []
    monitored root.edge := root.A [] ⊢ root.E []
  end
end

-- messages
