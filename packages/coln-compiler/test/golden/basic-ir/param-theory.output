-- elaborated
global entry named PointOf
in mode: Conjunctive
type: (X : Set) -> Theory
value: X => sig
  point : X
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  P : PointOf X
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.P := [a.point : root.X] primarykey []
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.P.foreignKey a.point := root.P [
      a.point ↦ a.point
    ] ⊢ a.point ∈ root.X []
    monitored root.P.total := ⊤ ⊢ root.P []
  end
end

-- messages
