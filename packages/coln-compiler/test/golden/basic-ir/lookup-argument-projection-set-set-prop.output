-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Set
  E : (x : A) -> B x -> Prop
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end

realm named TRealm

```flir
('root.A (table (ground) ()))
('root.B (table (ground) ((%a 'root.A))))
('root.E (table (ground (primarykey 2)) ((%x 'root.A) (%a 'root.B))))
('root.next (table (ground (primarykey 1)) ((%x 'root.A) (%a 'root.B))))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey
 (law enforced ((%a 'root.A)) (('root.B %a)) (('root.A (id %a)))))
('root.E.foreignKey
 (law
  enforced
  ((%x 'root.A) (%a 'root.B))
  (('root.E %x %a))
  (('root.A (id %x)) ('root.B (id %a) %x))))
('root.next.foreignKey
 (law
  enforced
  ((%x 'root.A) (%a 'root.B))
  (('root.next %x %a))
  (('root.A (id %x)) ('root.B (id %a) %x))))
('root.next.total
 (law monitored ((%x 'root.A)) (('root.A (id %x))) (('root.next %x))))
('root.nextedge
 (law
  monitored
  ((%x 'root.A) (%a 'root.B))
  (('root.next %x %a) ('root.A (id %x)))
  (('root.E %x %a))))
