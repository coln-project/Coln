-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : Set
  E : B -> Set
  x : A
  next : A -> B
  edge : E (next x)
end

realm named TRealm

```flir
('root.A (ground ()))
('root.B (ground ()))
('root.E (ground ((%a 'root.B))))
('root.x (ground ((%a 'root.A)) (primarykey 0)))
('root.next (ground ((%a 'root.A) (%b 'root.B)) (primarykey 1)))
('root.edge (ground ((%a 'root.E)) (primarykey 0)))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey (law enforced () (('root.B)) ()))
('root.E.foreignKey
 (law enforced ((%a 'root.B)) (('root.E %a)) (('root.B (id %a)))))
('root.x.foreignKey
 (law enforced ((%a 'root.A)) (('root.x %a)) (('root.A (id %a)))))
('root.x.total (law monitored () () (('root.x))))
('root.next.foreignKey
 (law
  enforced
  ((%a 'root.A) (%b 'root.B))
  (('root.next %a %b))
  (('root.A (id %a)) ('root.B (id %b)))))
('root.next.total
 (law monitored ((%a 'root.A)) (('root.A (id %a))) (('root.next %a))))
('root.edge.foreignKey
 (law
  enforced
  ((%a 'root.E) (%b 'root.B) (%c 'root.A))
  (('root.x %c) ('root.next %c %b) ('root.edge %a))
  (('root.E (id %a) %b))))
('root.edge.total (law monitored () () (('root.edge))))
