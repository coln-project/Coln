-- elaborated
global entry named Payload
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  first : X
  second : X
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  E : X -> Set
  r : (p : Payload X) -> E p.second
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.E := [a : root.X]
    table root.r := [
      p.first : root.X,
      p.second : root.X,
      a : root.E
    ] primarykey [p.first, p.second]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.E.foreignKey a := root.E [a ↦ a] ⊢ a ∈ root.X []
    enforced root.r.foreignKey p.first p.second a := root.r [
      p.first ↦ p.first,
      p.second ↦ p.second,
      a ↦ a
    ] ⊢ p.first ∈ root.X [] ∧ p.second ∈ root.X [] ∧ a ∈ root.E [a ↦ p.second]
    monitored root.r.total p.first p.second := p.first ∈ root.X [] ∧ p.second ∈ root.X [] ⊢ root.r [
      p.first ↦ p.first,
      p.second ↦ p.second
    ]
  end
end

-- messages
