-- elaborated
global entry named Evidence
in mode: Conjunctive
type: (P : Prop) -> Set
value: P => sig
  proof : P
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  P : Prop
  evidence : Evidence P
end
realm named TRealm
lowered: flatrealm
  entities
    table root.P := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.P.foreignKey := root.P [] ⊢ ⊤
    monitored root.evidence := ⊤ ⊢ root.P []
  end
end

-- messages
