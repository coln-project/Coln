-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : Prop
  E : B -> Prop
  x : A
  next : A -> B
  edge : E (next x)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := [] primarykey []
    table root.E := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ ⊤
    enforced root.E.foreignKey := root.E [] ⊢ root.B []
    monitored root.x := ⊤ ⊢ root.A []
    monitored root.next := root.A [] ⊢ root.B []
    monitored root.edge := ⊤ ⊢ root.E []
  end
end

-- messages
