-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  IntFact : Int -> Prop
  StringFact : String -> Prop
  intFact : IntFact 19
  stringFact : StringFact "zombocom"
end
realm named TRealm
elaborated: realm
  generators
    node
      IntFact = rel [a : Int]
      StringFact = rel [a : String]
      intFact = (fun [] -> TRealm.IntFact [a := 19])
      stringFact = (fun [] -> TRealm.StringFact [a := "zombocom"])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.IntFact := [.a : Int] primarykey [.a]
    table ℜ.StringFact := [.a : String] primarykey [.a]
  end
  rules
    enforced ℜ.IntFact.foreignKey a := ℜ.IntFact [.a ↦ a] ⊢ ⊤
    enforced ℜ.StringFact.foreignKey a := ℜ.StringFact [.a ↦ a] ⊢ ⊤
    monitored ℜ.intFact := ⊤ ⊢ ℜ.IntFact [.a ↦ 19]
    monitored ℜ.stringFact := ⊤ ⊢ ℜ.StringFact [.a ↦ "zombocom"]
  end
end

-- messages
