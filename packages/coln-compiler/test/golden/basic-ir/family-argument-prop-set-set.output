-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Set
  R : (a : A) -> B a -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := []
    table root.R := [b : root.B]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ root.A []
    enforced root.R.foreignKey b := root.R [b ↦ b] ⊢ root.A [] ∧ b ∈ root.B []
  end
end

-- messages
