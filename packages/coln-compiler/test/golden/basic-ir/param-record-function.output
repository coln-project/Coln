-- elaborated
global entry named Box
in mode: Conjunctive
type: (X : Set) -> (f : X -> X) -> (Y : Set) -> Set
value: X => f => Y => sig
  key : X
  value : Y
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  Key : Set
  f : Key -> Key
  boxed : Box Key f String -> Set
end
realm named TRealm
lowered: flatrealm
  entities
    table root.Key := []
    table root.f := [a : root.Key, b : root.Key] primarykey [a]
    table root.boxed := [a.key : root.Key, a.value : String]
  end
  definitions
  end
  rules
    enforced root.Key.foreignKey := root.Key [] ⊢ ⊤
    enforced root.f.foreignKey a b := root.f [
      a ↦ a,
      b ↦ b
    ] ⊢ a ∈ root.Key [] ∧ b ∈ root.Key []
    monitored root.f.total a := a ∈ root.Key [] ⊢ root.f [a ↦ a]
    enforced root.boxed.foreignKey a.key a.value := root.boxed [
      a.key ↦ a.key,
      a.value ↦ a.value
    ] ⊢ a.key ∈ root.Key []
  end
end

-- messages
