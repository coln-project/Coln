   (%v1 'root.red)
   (%w0 'root.blue)
   (%w1 'root.blue)
   (%a 'root.red-blue)
   (%c 'root.blue-red))
  (('root.red (id %v0))
   ('root.red (id %v1))
   ('root.blue (id %w0))
   ('root.blue (id %w1))
   ('root.red-blue (id %a) %v0 %w0)
   ('init.connection-info.blue-blue %w0 %w1)
   ('root.blue-red (id %c) %w1 %v1))
  ('init.connection-info.red-red %v0 %v1)))
('init.connection-info.blue/trans
 (rule
