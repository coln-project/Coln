-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Set
  C : (a : A) -> B a -> Prop
  f : (a : A) -> (b : B a) -> C a b
end
realm named TRealm
elaborated: realm
  generators
    node
      A = rel []
      B = rel [a : TRealm.A []]
      C = rel [a : TRealm.A [], b : TRealm.B [a := a]]
      f = (fun [a : TRealm.A [], b : TRealm.B [a := a]] -> TRealm.C [
        a := a,
        b := b
      ])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.A := [] primarykey []
    table ℜ.B := []
    table ℜ.C := [.b : ℜ.B] primarykey [.b]
    table ℜ.f := [.b : ℜ.B] primarykey [.b]
  end
  rules
    enforced ℜ.A.foreignKey := ℜ.A [] ⊢ ⊤
    enforced ℜ.B.foreignKey := ℜ.B [] ⊢ ℜ.A []
    enforced ℜ.C.foreignKey b := ℜ.C [.b ↦ b] ⊢ ℜ.A [] ∧ b ∈ ℜ.B []
    enforced ℜ.f.foreignKey b := ℜ.f [.b ↦ b] ⊢ ℜ.A [] ∧ b ∈ ℜ.B [] ∧ ℜ.C [
      .b ↦ b
    ]
    monitored ℜ.f.total b := ℜ.A [] ∧ b ∈ ℜ.B [] ⊢ ℜ.f [.b ↦ b]
  end
end

-- messages
