-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  P : Prop
  x : P
  y : P
  eq : x = y
end
realm named TRealm
elaborated: realm
  generators
    node
      P = rel []
      x = (fun [] -> TRealm.P [])
      y = (fun [] -> TRealm.P [])
      eq = (fun [] -> TRealm.x [] = TRealm.y [])
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.P := [] primarykey []
  end
  rules
    enforced ℜ.P.foreignKey := ℜ.P [] ⊢ ⊤
    monitored ℜ.x := ⊤ ⊢ ℜ.P []
    monitored ℜ.y := ⊤ ⊢ ℜ.P []
    monitored ℜ.eq := ⊤ ⊢ ⊤
  end
end

-- messages
