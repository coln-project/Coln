-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : Set
  E : B -> Prop
  x : A
  next : A -> B
  edge : E (next x)
end

realm named TRealm

```flir
('root.A (table (ground (primarykey 0)) ()))
('root.B (table (ground) ()))
('root.E (table (ground (primarykey 1)) ((%a 'root.B))))
('root.next (table (ground (primarykey 0)) ((%b 'root.B))))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey (law enforced () (('root.B)) ()))
('root.E.foreignKey
 (law enforced ((%a 'root.B)) (('root.E %a)) (('root.B (id %a)))))
('root.x (law monitored () () (('root.A))))
('root.next.foreignKey
 (law enforced ((%b 'root.B)) (('root.next %b)) (('root.A) ('root.B (id %b)))))
('root.next.total (law monitored () (('root.A)) (('root.next))))
('root.edge (law monitored ((%a 'root.B)) (('root.next %a)) (('root.E %a))))
```

