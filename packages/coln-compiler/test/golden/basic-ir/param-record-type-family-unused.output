in mode: Conjunctive
type: (X : Set) -> (E : X -> Set) -> Set
value: X => E => sig
  value : X
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  E : Int -> Set
  boxed : Box Int E -> Set
end

realm named TRealm

```flir
('root.E (table (ground) ((%a int))))
('root.boxed (table (ground) ((%a.value int))))
