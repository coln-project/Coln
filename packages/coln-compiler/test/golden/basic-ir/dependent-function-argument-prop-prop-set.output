-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Prop
  C : (a : A) -> B a -> Set
  f : (a : A) -> (b : B a) -> C a b
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := [] primarykey []
    table root.C := []
    table root.f := [c : root.C] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ root.A []
    enforced root.C.foreignKey := root.C [] ⊢ root.A [] ∧ root.B []
    enforced root.f.foreignKey c := root.f [
      c ↦ c
    ] ⊢ root.A [] ∧ root.B [] ∧ c ∈ root.C []
    monitored root.f.total := root.A [] ∧ root.B [] ⊢ root.f []
  end
end

-- messages
