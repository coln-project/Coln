-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Set
  C : (a : A) -> B a -> Set
  f : (a : A) -> (b : B a) -> C a b
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := []
    table root.C := [b : root.B]
    table root.f := [b : root.B, c : root.C] primarykey [b]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ root.A []
    enforced root.C.foreignKey b := root.C [b ↦ b] ⊢ root.A [] ∧ b ∈ root.B []
    enforced root.f.foreignKey b c := root.f [
      b ↦ b,
      c ↦ c
    ] ⊢ root.A [] ∧ b ∈ root.B [] ∧ c ∈ root.C [b ↦ b]
    monitored root.f.total b := root.A [] ∧ b ∈ root.B [] ⊢ root.f [b ↦ b]
  end
end

-- messages
