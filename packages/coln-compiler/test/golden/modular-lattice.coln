theory ModularLattice := sig
  Element : Set

  # ⋀ as a function
  meet : Element -> Element -> Element

  # Associativity: a ⋀ (b ⋀ c) = (a ⋀ b) ⋀ c
  meet/associative : (a : Element) -> (b : Element) -> (c : Element) -> (
    meet (meet a b) c = meet a (meet b c)
  )
  # Commutativity: a ⋀ b = b ⋀ a
  meet/commutative : (a : Element) -> (b : Element) -> (
    meet a b = meet b a
  )
  # Idempotence: a ⋀ a = a
  meet/idempotent : (^c a : Element) -> (
    meet a a = a
  )
  # ⋁ as a function
  join : Element -> Element -> Element

  # Associativity: a ⋁ (b ⋁ c) = (a ⋁ b) ⋁ c
  join/associative : (^c a : Element) -> (^c b : Element) -> (^c c : Element) -> (
    join (join a b) c = join a (join b c)
  )
  # Commutativity: a ⋁ b = b ⋁ a
  join/commutative : (^c a : Element) -> (^c b : Element) -> (
    join a b = join b a
  )
  # Idempotence: a ⋁ a = a
  join/idempotent : (^c a : Element) -> (
    join a a = a
  )
  # absorptive laws, which actually imply idempotence but nvm: a ⋀ (a ⋁ b) = a ⋁ (a ⋀ b) = a
  ax/absorptive1 : (^c a : Element) -> (^c b : Element) ->  (
    meet a (join a b) = a
  )
  ax/absorptive2 : (^c a : Element) -> (^c b : Element) -> (
    join a (meet a b) = a
  )
  # the modular identity (a ⋀ b) ⋁ (x ⋀ b) = ((a ⋀ b) ⋁ x) ⋀ b.
  ax/modular : (^c a : Element) -> (^c b : Element) -> (^c x : Element) -> (
    join (meet a b) (meet x b) = meet (join (meet a b) x) b
  )
end
