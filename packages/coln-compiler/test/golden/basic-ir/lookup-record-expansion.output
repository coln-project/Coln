-- elaborated
global entry named Payload
in mode: Conjunctive
type: Set
value: sig
  name : String
  rank : Int
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  payload : X -> Payload
  E : Payload -> Set
  edge : (x : X) -> E (payload x)
end

realm named TRealm

```flir
('root.X (table (ground) ()))
('root.payload
 (table (ground (primarykey 1)) ((%a 'root.X) (%b.name string) (%b.rank int))))
('root.E (table (ground) ((%a.name string) (%a.rank int))))
('root.edge (table (ground (primarykey 1)) ((%x 'root.X) (%a 'root.E))))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.payload.foreignKey
 (law
  enforced
  ((%a 'root.X) (%b.name string) (%b.rank int))
  (('root.payload %a %b.name %b.rank))
  (('root.X (id %a)))))
('root.payload.total
 (law monitored ((%a 'root.X)) (('root.X (id %a))) (('root.payload %a))))
('root.E.foreignKey
 (law enforced ((%a.name string) (%a.rank int)) (('root.E %a.name %a.rank)) ()))
('root.edge.foreignKey
 (law
  enforced
  ((%x 'root.X) (%a 'root.E) (%b.name string) (%b.rank int))
  (('root.payload %x %b.name %b.rank) ('root.edge %x %a))
  (('root.X (id %x)) ('root.E (id %a) %b.name %b.rank))))
('root.edge.total
 (law monitored ((%x 'root.X)) (('root.X (id %x))) (('root.edge %x))))
