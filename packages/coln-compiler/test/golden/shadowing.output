realm named PairRealm
lowered: flatrealm
  entities
    table root := [a.x : Int, a.y : Int] primarykey []
  end
  definitions
  end
  rules
    enforced root.foreignKey a.x a.y := root [a.x ↦ a.x, a.y ↦ a.y] ⊢ ⊤
    monitored root.total := ⊤ ⊢ root []
  end
end
realm named ShadowRealm
lowered: flatrealm
  entities
    table root := [a.x : Int, a.y : Int] primarykey []
  end
  definitions
  end
  rules
    enforced root.foreignKey a.x a.y := root [a.x ↦ a.x, a.y ↦ a.y] ⊢ ⊤
    monitored root.total := ⊤ ⊢ root []
  end
end

