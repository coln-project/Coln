-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Prop
  E : (x : A) -> B x -> Prop
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end

realm named TRealm

```flir
('root.A (table (ground) ()))
('root.B (table (ground (primarykey 1)) ((%a 'root.A))))
('root.E (table (ground (primarykey 1)) ((%x 'root.A))))
('root.A.foreignKey (law enforced () (('root.A)) ()))
('root.B.foreignKey
 (law enforced ((%a 'root.A)) (('root.B %a)) (('root.A (id %a)))))
('root.E.foreignKey
 (law enforced ((%x 'root.A)) (('root.E %x)) (('root.A (id %x)) ('root.B %x))))
('root.next (law monitored ((%x 'root.A)) (('root.A (id %x))) (('root.B %x))))
('root.nextedge
 (law monitored ((%x 'root.A)) (('root.A (id %x))) (('root.E %x))))
```

