-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Prop
  R : (a : A) -> B a -> Prop
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := [] primarykey []
    table root.R := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ root.A []
    enforced root.R.foreignKey := root.R [] ⊢ root.A [] ∧ root.B []
  end
end

-- messages
