value: [a := 7, b := 11]
global entry named Bound
in mode: Conjunctive
type: Theory
value: sig
  x y : Int
  p : x = x
  q : y = y
end
global entry named Q
in mode: Conjunctive
type: Prop
value: sig
end
global entry named SimpleProps
in mode: Conjunctive
type: Theory
value: sig
  x : Q
  y z : Q
  w : Q
