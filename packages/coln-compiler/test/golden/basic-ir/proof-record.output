-- elaborated
global entry named Witness
in mode: Conjunctive
type: (X : Set) -> (x : X) -> Set
value: X => x => sig
  proof : x = x
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  witness : (x : X) -> Witness X x
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    monitored root.witness x := x ∈ root.X [] ⊢ x = x
  end
end

-- messages
