-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Prop
  E : (x : A) -> B x -> Set
  next : (x : A) -> B x
  nextedge : (x : A) -> E x (next x)
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := [] primarykey []
    table root.B := [] primarykey []
    table root.E := []
    table root.nextedge := [a : root.E] primarykey []
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey := root.B [] ⊢ root.A []
    enforced root.E.foreignKey := root.E [] ⊢ root.A [] ∧ root.B []
    monitored root.next := root.A [] ⊢ root.B []
    enforced root.nextedge.foreignKey a := root.nextedge [
      a ↦ a
    ] ⊢ root.A [] ∧ a ∈ root.E []
    monitored root.nextedge.total := root.A [] ⊢ root.nextedge []
  end
end

-- messages
