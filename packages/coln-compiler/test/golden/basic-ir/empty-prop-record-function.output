-- elaborated
global entry named Truth
in mode: Conjunctive
type: Prop
value: sig
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  trivial : (x : X) -> Truth
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
  end
end

-- messages
