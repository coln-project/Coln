-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Set
  B : A -> Prop
  C : (a : A) -> B a -> Set
  f : (a : A) -> (b : B a) -> C a b
end
realm named TRealm
lowered: flatrealm
  entities
    table root.A := []
    table root.B := [a : root.A] primarykey [a]
    table root.C := [a : root.A]
    table root.f := [a : root.A, c : root.C] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.A.foreignKey := root.A [] ⊢ ⊤
    enforced root.B.foreignKey a := root.B [a ↦ a] ⊢ a ∈ root.A []
    enforced root.C.foreignKey a := root.C [a ↦ a] ⊢ a ∈ root.A [] ∧ root.B [
      a ↦ a
    ]
    enforced root.f.foreignKey a c := root.f [
      a ↦ a,
      c ↦ c
    ] ⊢ a ∈ root.A [] ∧ root.B [a ↦ a] ∧ c ∈ root.C [a ↦ a]
    monitored root.f.total a := a ∈ root.A [] ∧ root.B [a ↦ a] ⊢ root.f [a ↦ a]
  end
end

-- messages
