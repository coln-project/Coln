-- elaborated
global entry named EqualTriple
in mode: Conjunctive
type: (X : Set) -> Set
value: X => sig
  first : X
  second : X
  proof : first = second
  trailing : X
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  Accepted : EqualTriple X -> Prop
end
realm named TRealm
elaborated: realm
  generators
    node
      X = rel []
      Accepted = rel [a : EqualTriple (TRealm.X [])]
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.X := []
    table ℜ.Accepted := [
      .a.first : ℜ.X,
      .a.second : ℜ.X,
      .a.trailing : ℜ.X
    ] primarykey [.a.first, .a.second, .a.trailing]
  end
  rules
    enforced ℜ.X.foreignKey := ℜ.X [] ⊢ ⊤
    enforced ℜ.Accepted.foreignKey a.first a.second a.trailing := ℜ.Accepted [
      .a.first ↦ a.first,
      .a.second ↦ a.second,
      .a.trailing ↦ a.trailing
    ] ⊢ a.first ∈ ℜ.X [] ∧ a.second ∈ ℜ.X [] ∧ a.first = a.second ∧ a.trailing ∈ ℜ.X []
  end
end

-- messages
