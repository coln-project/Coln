-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  P : Prop
  Q : Prop
  R : X -> P -> Q -> Prop
end
realm named TRealm
lowered: flatrealm
  entities
    table root.X := []
    table root.P := [] primarykey []
    table root.Q := [] primarykey []
    table root.R := [a : root.X] primarykey [a]
  end
  definitions
  end
  rules
    enforced root.X.foreignKey := root.X [] ⊢ ⊤
    enforced root.P.foreignKey := root.P [] ⊢ ⊤
    enforced root.Q.foreignKey := root.Q [] ⊢ ⊤
    enforced root.R.foreignKey a := root.R [
      a ↦ a
    ] ⊢ a ∈ root.X [] ∧ root.P [] ∧ root.Q []
  end
end

-- messages
