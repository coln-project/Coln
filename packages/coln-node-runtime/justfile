build-runtime:
    npx napi build --platform --esm -o native
    mkdir -p dist
    cp -r native dist/native

generate-bindings:
    cabal run coln-cli -- generate-ts test/definitions.coln -o test

test: build-runtime generate-bindings
    mkdir -p dist
    tsc
    cabal run coln-cli -- generate-ir test/definitions.coln -o dist/test
    node dist/test/main.js
