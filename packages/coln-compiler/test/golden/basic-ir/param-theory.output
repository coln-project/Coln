-- elaborated
global entry named PointOf
in mode: Conjunctive
type: (X : Set) -> Theory
value: X => sig
  point : X
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  X : Set
  P : PointOf X
end

realm named TRealm

```flir
('root.X (ground ()))
('root.P (ground ((%a.point 'root.X)) (primarykey 0)))
('root.X.foreignKey (law enforced () (('root.X)) ()))
('root.P.foreignKey
 (law
  enforced
  ((%a.point 'root.X))
  (('root.P %a.point))
  (('root.X (id %a.point)))))
('root.P.total (law monitored () () (('root.P))))
```

