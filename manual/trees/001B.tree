\title{The type of sets}
\import{prelude}

\p{There is a type \code{Set}, whose elements are collections of things.}

\p{As a database schema, this produces a table of completely abstract row-ids, with no associated data.}

\pre{%
\kw{theory} GoldenTicket := Set
}

\dbexample{
  \p{\strong{Table \code{GoldenTicket}}}

  \table{
    \row{\hcell{RowID}}
  }{
    \row{\cell{\code{a}}}
    \row{\cell{\code{b}}}
  }

  \p{\strong{Constraints:}
  \ul{
    \li{None.}
  }
  }
}

\p{ \mvrnote{smooth} In particular we have \code{String : Set} and \code{Int : Set}.}
