-- elaborated
global entry named Witness
in mode: Conjunctive
type: (P : Prop) -> Prop
value: P => sig
  first : P
  second : P
  same : first = second
end
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  P : Prop
  witness : Witness P
end
realm named TRealm
lowered: flatrealm
  entities
    table root.P := [] primarykey []
  end
  definitions
  end
  rules
    enforced root.P.foreignKey := root.P [] ⊢ ⊤
    monitored root.witness := ⊤ ⊢ root.P [] ∧ root.P []
  end
end

-- messages
