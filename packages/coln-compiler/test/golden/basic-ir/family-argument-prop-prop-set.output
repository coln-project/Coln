-- elaborated
global entry named T
in mode: Conjunctive
type: Theory
value: sig
  A : Prop
  B : A -> Prop
  R : (a : A) -> B a -> Set
end
realm named TRealm
elaborated: realm
  generators
    node
      A = rel []
      B = rel [a : TRealm.A []]
      R = rel [a : TRealm.A [], b : TRealm.B [a := a]]
    end
  end
  definitions
  end
end
lowered: flatrealm
  entities
    table ℜ.A := [] primarykey []
    table ℜ.B := [] primarykey []
    table ℜ.R := []
  end
  rules
    enforced ℜ.A.foreignKey := ℜ.A [] ⊢ ⊤
    enforced ℜ.B.foreignKey := ℜ.B [] ⊢ ℜ.A []
    enforced ℜ.R.foreignKey := ℜ.R [] ⊢ ℜ.A [] ∧ ℜ.B []
  end
end

-- messages
