-- elaborated
global entry named Payload
in mode: Conjunctive
type: Set
value: sig
  name : String
  rank : Int
end

global entry named T
in mode: Conjunctive
type: Theory
value: sig
  point : Set
  payload : point -> Payload
end

realm named TRealm

```flir
('root.point (ground ()))
('root.payload
 (ground ((%a 'root.point) (%b.name string) (%b.rank int)) (primarykey 1)))
('root.point.foreignKey (law enforced () (('root.point)) ()))
('root.payload.foreignKey
 (law
  enforced
  ((%a 'root.point) (%b.name string) (%b.rank int))
  (('root.payload %a %b.name %b.rank))
  (('root.point (id %a)))))
('root.payload.total
 (law
  monitored
  ((%a 'root.point))
  (('root.point (id %a)))
  (('root.payload %a))))
```

